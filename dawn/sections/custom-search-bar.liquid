{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    height: 0 !important;
    width: 100% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 10;
  }
{% endstyle %}
<div class="custom-search-bar-section" style="background-color: {{ section.settings.section_background }};">
  <div class="custom-search-container" style="background-color: {{ section.settings.bar_background }};">
    <form action="{{ routes.search_url }}" method="get" role="search" class="custom-search-form">
      <input
        type="text"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder_text }}"
        class="custom-search-input"
        aria-label="{{ section.settings.placeholder_text }}"
      >
      <input type="hidden" name="type" value="product">
      <button
        type="submit"
        class="custom-search-button"
        style="background-color: {{ section.settings.button_color }}; color: {{ section.settings.button_text_color }};"
      >
        {{ section.settings.button_text }}
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.querySelector('.custom-search-input');
    if (!searchInput) return;

    const originalPlaceholder =
      searchInput.getAttribute('aria-label') || '{{ section.settings.placeholder_text | escape }}';
    const chars = originalPlaceholder.split('');
    let currentCharIndex = 0;

    // Start empty
    searchInput.setAttribute('placeholder', '');

    function typeChars() {
      if (currentCharIndex <= chars.length) {
        const textToDisplay = chars.slice(0, currentCharIndex).join('');
        searchInput.setAttribute('placeholder', textToDisplay);
        currentCharIndex++;

        if (currentCharIndex <= chars.length) {
          setTimeout(typeChars, 60); // 60ms per character
        } else {
          // Restart after a pause
          setTimeout(() => {
            currentCharIndex = 0;
            searchInput.setAttribute('placeholder', '');
            setTimeout(typeChars, 500);
          }, 3000); // 3 seconds pause before restart
        }
      }
    }

    // Start animation
    setTimeout(typeChars, 500);
  });
</script>

