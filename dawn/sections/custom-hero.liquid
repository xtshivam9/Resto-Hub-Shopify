{{ 'custom-hero.css' | asset_url | append: '?v=5' | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .custom-hero-section {
    min-height: {{ section.settings.hero_height_desktop }}px;
  }

  @media screen and (max-width: 1540px) {
    #shopify-section-{{ section.id }} .custom-hero-section {
      min-height: {{ section.settings.hero_height_laptop }}px;
    }
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .custom-hero-section {
      min-height: {{ section.settings.hero_height_tablet }}px;
    }
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} .custom-hero-section {
      height: {{ section.settings.hero_height_mobile }}px;
      min-height: unset;
    }
  }

  /* Per-slide background images */
  {%- for block in section.blocks -%}
    {%- assign desktop_bg = 'hero1.svg' | asset_url -%}
    {%- if block.settings.background_image != blank -%}
      {%- assign desktop_bg = block.settings.background_image | image_url: width: 2000 -%}
    {%- endif -%}

    {%- assign mobile_bg = 'mobile.svg' | asset_url -%}
    {%- if block.settings.mobile_background_image != blank -%}
      {%- assign mobile_bg = block.settings.mobile_background_image | image_url: width: 1000 -%}
    {%- endif -%}

    #shopify-section-{{ section.id }} .hero-slide[data-index="{{ forloop.index0 }}"] {
      background-image: url({{ desktop_bg }});
    }

    @media screen and (max-width: 576px) {
      #shopify-section-{{ section.id }} .hero-slide[data-index="{{ forloop.index0 }}"] {
        background-image: url({{ mobile_bg }});
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<div class="custom-hero-section" id="hero-slider-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">
  <!-- Slides -->
  {%- for block in section.blocks -%}
    <div class="hero-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
      <div class="custom-hero-content">
        {% if block.settings.heading != blank %}
          <h1 class="custom-hero-heading" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="custom-hero-description" style="color: {{ block.settings.text_color }};">{{ block.settings.description }}</div>
        {% endif %}

        <div class="custom-hero-buttons">
          {% if block.settings.button_1_text != blank %}
            <a href="{{ block.settings.button_1_link }}" class="custom-hero-btn btn-primary">{{ block.settings.button_1_text }}</a>
          {% endif %}

          {% if block.settings.button_2_text != blank %}
            <a href="{{ block.settings.button_2_link }}" class="custom-hero-btn btn-secondary">{{ block.settings.button_2_text }}</a>
          {% endif %}
        </div>

        <div class="custom-hero-features">
          {%- for i in (1..3) -%}
            {%- assign icon_key = 'feature_' | append: i | append: '_icon' -%}
            {%- assign text_key = 'feature_' | append: i | append: '_text' -%}
            {%- assign f_text = block.settings[text_key] -%}
            {%- if f_text != blank -%}
              <div class="custom-hero-feature-item">
                {%- assign f_icon = block.settings[icon_key] -%}
                {%- if f_icon != blank -%}
                  <img src="{{ f_icon | image_url: width: 50 }}" alt="{{ f_text }}" width="40" height="40">
                {%- else -%}
                  {%- assign icon_name = 'float-icon' | append: i | append: '.svg' -%}
                  <img src="{{ icon_name | asset_url }}" alt="{{ f_text }}" width="40" height="40">
                {%- endif -%}
                <span style="color: {{ block.settings.text_color }};">{{ f_text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endfor -%}

  <!-- Navigation Arrows -->
  {%- if section.blocks.size > 1 -%}
    <button class="hero-arrow hero-arrow--prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="hero-arrow hero-arrow--next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <!-- Dots -->
    <div class="hero-dots">
      {%- for block in section.blocks -%}
        <button class="hero-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
(function() {
  var slider = document.getElementById('hero-slider-{{ section.id }}');
  if (!slider) return;

  var slides = slider.querySelectorAll('.hero-slide');
  var dots = slider.querySelectorAll('.hero-dot');
  var prevBtn = slider.querySelector('.hero-arrow--prev');
  var nextBtn = slider.querySelector('.hero-arrow--next');
  var total = slides.length;
  if (total <= 1) return;

  var current = 0;
  var autoplay = slider.getAttribute('data-autoplay') === 'true';
  var speed = parseInt(slider.getAttribute('data-speed'), 10) || 5000;
  var interval = null;
  var touchStartX = 0;
  var touchEndX = 0;

  function goTo(index) {
    if (index < 0) index = total - 1;
    if (index >= total) index = 0;

    slides[current].classList.remove('active');
    if (dots[current]) dots[current].classList.remove('active');

    current = index;

    slides[current].classList.add('active');
    if (dots[current]) dots[current].classList.add('active');
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function startAutoplay() {
    if (autoplay && !interval) {
      interval = setInterval(next, speed);
    }
  }

  function stopAutoplay() {
    if (interval) {
      clearInterval(interval);
      interval = null;
    }
  }

  // Arrow clicks
  if (nextBtn) nextBtn.addEventListener('click', function() { stopAutoplay(); next(); startAutoplay(); });
  if (prevBtn) prevBtn.addEventListener('click', function() { stopAutoplay(); prev(); startAutoplay(); });

  // Dot clicks
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      stopAutoplay();
      goTo(parseInt(dot.getAttribute('data-index'), 10));
      startAutoplay();
    });
  });

  // Touch swipe
  slider.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  slider.addEventListener('touchend', function(e) {
    touchEndX = e.changedTouches[0].screenX;
    var diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) {
      stopAutoplay();
      if (diff > 0) next(); else prev();
      startAutoplay();
    }
  }, { passive: true });

  // Pause on hover (desktop)
  slider.addEventListener('mouseenter', stopAutoplay);
  slider.addEventListener('mouseleave', startAutoplay);

  // Start
  startAutoplay();
})();
</script>

