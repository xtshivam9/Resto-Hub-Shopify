{{ 'custom-hero.css' | asset_url | append: '?v=12' | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} .hero-arrow {
      display: none;
    }
  }
{%- endstyle -%}

<div
  class="custom-hero-section"
  id="hero-slider-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  <!-- Slides -->
  <div class="hero-slider-track">
    {%- for block in section.blocks -%}
      <div
        class="hero-slide {% if forloop.first %}active{% endif %}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {%- comment -%} Slide background image using <picture> for mobile/desktop variants {%- endcomment -%}
        {%- if block.settings.background_image != blank or block.settings.mobile_background_image != blank -%}
          {%- if block.settings.slide_link != blank -%}
            <a href="{{ block.settings.slide_link }}" class="hero-slide-link">
          {%- endif -%}
          <picture>
            {%- if block.settings.mobile_background_image != blank -%}
              <source
                media="(max-width: 576px)"
                srcset="{{ block.settings.mobile_background_image | image_url: width: 1000 }}"
              >
            {%- endif -%}
            {%- if block.settings.background_image != blank -%}
              <img
                class="hero-slide-bg"
                src="{{ block.settings.background_image | image_url: width: 2000 }}"
                alt="{{ block.settings.heading | default: 'Hero slide' }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="2000"
                height="1000"
              >
            {%- elsif block.settings.mobile_background_image != blank -%}
              <img
                class="hero-slide-bg"
                src="{{ block.settings.mobile_background_image | image_url: width: 1000 }}"
                alt="{{ block.settings.heading | default: 'Hero slide' }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="1000"
                height="1000"
              >
            {%- endif -%}
          </picture>
          {%- if block.settings.slide_link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}

        <div class="custom-hero-content">
          {%- if block.settings.show_heading and block.settings.heading != blank -%}
            <h1 class="custom-hero-heading" style="color: {{ block.settings.text_color }};">
              {{ block.settings.heading }}
            </h1>
          {%- endif -%}

          {%- if block.settings.show_description and block.settings.description != blank -%}
            <div class="custom-hero-description" style="color: {{ block.settings.text_color }};">
              {{ block.settings.description }}
            </div>
          {%- endif -%}

          {%- if block.settings.show_buttons -%}
            {%- if block.settings.button_1_text != blank or block.settings.button_2_text != blank -%}
              <div class="custom-hero-buttons">
                {%- if block.settings.button_1_text != blank -%}
                  <a href="{{ block.settings.button_1_link }}" class="custom-hero-btn btn-primary">
                    {{- block.settings.button_1_text -}}
                  </a>
                {%- endif -%}

                {%- if block.settings.button_2_text != blank -%}
                  <a href="{{ block.settings.button_2_link }}" class="custom-hero-btn btn-secondary">
                    {{- block.settings.button_2_text -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.show_features -%}
            {%- assign has_any_feature = false -%}
            {%- for i in (1..3) -%}
              {%- assign text_key = 'feature_' | append: i | append: '_text' -%}
              {%- if block.settings[text_key] != blank -%}
                {%- assign has_any_feature = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if has_any_feature -%}
              <div class="custom-hero-features">
                {%- for i in (1..3) -%}
                  {%- assign icon_key = 'feature_' | append: i | append: '_icon' -%}
                  {%- assign text_key = 'feature_' | append: i | append: '_text' -%}
                  {%- assign f_text = block.settings[text_key] -%}
                  {%- if f_text != blank -%}
                    <div class="custom-hero-feature-item">
                      {%- assign f_icon = block.settings[icon_key] -%}
                      {%- if f_icon != blank -%}
                        <img src="{{ f_icon | image_url: width: 50 }}" alt="{{ f_text }}" width="40" height="40">
                      {%- endif -%}
                      <span style="color: {{ block.settings.text_color }};">{{ f_text }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  <!-- end .hero-slider-track -->

  {%- if section.blocks.size > 1 -%}
    <!-- Dots -->
    <div class="hero-dots">
      {%- for block in section.blocks -%}
        <button
          class="hero-dot {% if forloop.first %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var slider = document.getElementById('hero-slider-{{ section.id }}');
    if (!slider) return;

    var track = slider.querySelector('.hero-slider-track');
    var originalSlides = slider.querySelectorAll('.hero-slide');
    var dots = slider.querySelectorAll('.hero-dot');
    var total = originalSlides.length;
    if (total <= 1) return;

    var autoplay = slider.getAttribute('data-autoplay') === 'true';
    var speed = parseInt(slider.getAttribute('data-speed'), 10) || 5000;
    var interval = null;
    var touchStartX = 0;
    var touchEndX = 0;
    var isTransitioning = false;

    function updateHeight() {
      /* Get all slides including clones */
      var allSlides = track.querySelectorAll('.hero-slide');
      /* current index accounts for prepended clone */
      if (allSlides[current]) {
        slider.style.height = allSlides[current].scrollHeight + 'px';
      }
    }

    /* ---- Infinite loop: clone first and last slides ---- */
    var firstClone = originalSlides[0].cloneNode(true);
    var lastClone = originalSlides[total - 1].cloneNode(true);
    firstClone.classList.add('hero-slide-clone');
    lastClone.classList.add('hero-slide-clone');
    firstClone.removeAttribute('data-index');
    lastClone.removeAttribute('data-index');
    track.appendChild(firstClone);
    track.insertBefore(lastClone, track.firstChild);

    /* current = 1 because index 0 is now the lastClone prepended */
    var current = 1;
    track.style.transform = 'translateX(-' + current * 100 + '%)';

    // Set initial height
    updateHeight();
    window.addEventListener('resize', updateHeight);

    function updateDots(realIndex) {
      dots.forEach(function (d) {
        d.classList.remove('active');
      });
      if (dots[realIndex]) dots[realIndex].classList.add('active');
    }

    function getRealIndex() {
      /* total original slides, current is 1-based because of prepended clone */
      return current - 1;
    }

    function goTo(index) {
      if (isTransitioning) return;
      isTransitioning = true;
      current = index;
      track.style.transition = 'transform 0.6s ease-in-out';
      track.style.transform = 'translateX(-' + current * 100 + '%)';
      updateHeight();

      /* Update dots to the real index (clamped) */
      var realIdx = current - 1;
      if (realIdx < 0) realIdx = total - 1;
      if (realIdx >= total) realIdx = 0;
      updateDots(realIdx);
    }

    /* When transition ends, silently jump if we're on a clone */
    track.addEventListener('transitionend', function () {
      isTransitioning = false;
      if (current === 0) {
        /* On last-clone (prepended) → jump to real last slide */
        track.style.transition = 'none';
        current = total;
        track.style.transform = 'translateX(-' + current * 100 + '%)';
      } else if (current === total + 1) {
        /* On first-clone (appended) → jump to real first slide */
        track.style.transition = 'none';
        current = 1;
        track.style.transform = 'translateX(-' + current * 100 + '%)';
      }
    });

    function next() {
      goTo(current + 1);
    }
    function prev() {
      goTo(current - 1);
    }

    function startAutoplay() {
      if (autoplay && !interval) {
        interval = setInterval(next, speed);
      }
    }

    function stopAutoplay() {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
    }

    /* Dot clicks */
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        stopAutoplay();
        var dotIndex = parseInt(dot.getAttribute('data-index'), 10);
        goTo(dotIndex + 1); /* +1 because of prepended clone */
        startAutoplay();
      });
    });

    /* Touch swipe */
    slider.addEventListener(
      'touchstart',
      function (e) {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    slider.addEventListener(
      'touchend',
      function (e) {
        touchEndX = e.changedTouches[0].screenX;
        var diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          stopAutoplay();
          if (diff > 0) next();
          else prev();
          startAutoplay();
        }
      },
      { passive: true }
    );

    /* Pause on hover (desktop) */
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);

    /* Start */
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "header",
      "content": "Section Height"
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "label": "Desktop Height (px)",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "hero_height_laptop",
      "label": "Laptop Height (px)",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "hero_height_tablet",
      "label": "Tablet Height (px)",
      "min": 100,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Mobile Height (px)",
      "min": 100,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (ms)",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Background Images"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_background_image",
          "label": "Background Image (Mobile)"
        },
        {
          "type": "header",
          "content": "Slide Link"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link (redirect on click)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "header",
          "content": "Visibility Toggles"
        },
        {
          "type": "checkbox",
          "id": "show_heading",
          "label": "Show Heading",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "label": "Show Description",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_buttons",
          "label": "Show Buttons",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_features",
          "label": "Show Features",
          "default": true
        },
        {
          "type": "header",
          "content": "Button 1 (Primary)"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Button 1 Text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Button 2 (Secondary)"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Button 2 Text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Feature 1"
        },
        {
          "type": "image_picker",
          "id": "feature_1_icon",
          "label": "Feature 1 Icon"
        },
        {
          "type": "text",
          "id": "feature_1_text",
          "label": "Feature 1 Text"
        },
        {
          "type": "header",
          "content": "Feature 2"
        },
        {
          "type": "image_picker",
          "id": "feature_2_icon",
          "label": "Feature 2 Icon"
        },
        {
          "type": "text",
          "id": "feature_2_text",
          "label": "Feature 2 Text"
        },
        {
          "type": "header",
          "content": "Feature 3"
        },
        {
          "type": "image_picker",
          "id": "feature_3_icon",
          "label": "Feature 3 Icon"
        },
        {
          "type": "text",
          "id": "feature_3_text",
          "label": "Feature 3 Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "blocks": [
        {
          "type": "hero_slide"
        }
      ]
    }
  ]
}
{% endschema %}
