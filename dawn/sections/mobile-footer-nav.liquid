{{ 'mobile-footer-nav.css' | asset_url | stylesheet_tag }}

<nav class="mobile-footer-nav" aria-label="Mobile footer navigation">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- assign is_active = false -%}
      {%- if block.settings.url == '/' and request.path == '/' -%}
        {%- assign is_active = true -%}
      {%- elsif block.settings.url != '/' and request.path contains block.settings.url -%}
        {%- assign is_active = true -%}
      {%- endif -%}

      <a
        href="{{ block.settings.url }}"
        class="mobile-footer-nav__item{% if is_active %} mobile-footer-nav__item--active{% endif %}"
        aria-label="{{ block.settings.label }}"
        {{ block.shopify_attributes }}
      >
        <span class="mobile-footer-nav__icon">
          {%- case block.settings.icon -%}
            {%- when 'home' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 14 15 14 15 21"/>
              </svg>
            {%- when 'shop' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            {%- when 'categories' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            {%- when 'gift' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
              </svg>
            {%- when 'account' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            {%- when 'heart' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            {%- when 'search' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            {%- when 'cart' -%}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>
          {%- endcase -%}
        </span>
        <span class="mobile-footer-nav__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} Fallback default items when no blocks are configured (static section) {%- endcomment -%}
    <a
      href="{{ routes.root_url }}"
      class="mobile-footer-nav__item{% if request.path == routes.root_url %} mobile-footer-nav__item--active{% endif %}"
      aria-label="Home"
    >
      <span class="mobile-footer-nav__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 14 15 14 15 21"/>
        </svg>
      </span>
      <span class="mobile-footer-nav__label">Home</span>
    </a>
    <a
      href="{{ routes.all_products_collection_url }}"
      class="mobile-footer-nav__item{% if request.path contains routes.all_products_collection_url %} mobile-footer-nav__item--active{% endif %}"
      aria-label="Shop All"
    >
      <span class="mobile-footer-nav__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </span>
      <span class="mobile-footer-nav__label">Shop All</span>
    </a>
    <a
      href="{{ routes.collections_url }}"
      class="mobile-footer-nav__item{% if request.path == routes.collections_url %} mobile-footer-nav__item--active{% endif %}"
      aria-label="Categories"
    >
      <span class="mobile-footer-nav__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
      </span>
      <span class="mobile-footer-nav__label">Categories</span>
    </a>
    <a
      href="{{ routes.collections_url }}/new-arrivals"
      class="mobile-footer-nav__item{% if request.path contains '/collections/new-arrivals' %} mobile-footer-nav__item--active{% endif %}"
      aria-label="New Arrivals"
    >
      <span class="mobile-footer-nav__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
        </svg>
      </span>
      <span class="mobile-footer-nav__label">New Arrivals</span>
    </a>
    <a
      href="{{ routes.account_url }}"
      class="mobile-footer-nav__item{% if request.path contains routes.account_url %} mobile-footer-nav__item--active{% endif %}"
      aria-label="Account"
    >
      <span class="mobile-footer-nav__icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </span>
      <span class="mobile-footer-nav__label">Account</span>
    </a>
  {%- endif -%}
</nav>

{% schema %}
{
  "name": "Mobile Footer Nav",
  "class": "mobile-footer-nav-section",
  "settings": [],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "home", "label": "Home" },
            { "value": "shop", "label": "Shop / Bag" },
            { "value": "categories", "label": "Categories / Grid" },
            { "value": "gift", "label": "Gift / New Arrivals" },
            { "value": "account", "label": "Account / Person" },
            { "value": "heart", "label": "Heart / Wishlist" },
            { "value": "search", "label": "Search" },
            { "value": "cart", "label": "Cart" }
          ],
          "default": "home"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Footer Nav",
      "blocks": [
        {
          "type": "menu_item",
          "settings": {
            "label": "Home",
            "url": "/",
            "icon": "home"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label": "Shop All",
            "url": "/collections/all",
            "icon": "shop"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label": "Categories",
            "url": "/collections",
            "icon": "categories"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label": "New Arrivals",
            "url": "/collections/new-arrivals",
            "icon": "gift"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label": "Account",
            "url": "/account",
            "icon": "account"
          }
        }
      ]
    }
  ]
}
{% endschema %}
