{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'form-image.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.page_full_width %}page-full-width{% else %}page-width{% endif %} isolate">
    <div class="section-{{ section.id }}-padding contact-form-section">
      
      {%- if section.settings.title != blank or section.settings.sub_heading != blank -%}
      <div class="contact-header center">
        {%- if section.settings.sub_heading != blank -%}
          <p class="sub-heading">{{ section.settings.sub_heading }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}

      <div class="contact-info-blocks">
        <div class="info-block">
          {%- if section.settings.address_url != blank -%}
            <a href="{{ section.settings.address_url }}" class="icon-circle-link" target="_blank" rel="noopener noreferrer">
              <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" class="icon-line"><path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 22V12H15V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </a>
          {%- else -%}
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" class="icon-line"><path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 22V12H15V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          {%- endif -%}
          <div class="info-text">
            {%- if section.settings.address_url != blank -%}
              <p><a href="{{ section.settings.address_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.address_line_1 }}</a></p>
              <p><a href="{{ section.settings.address_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.address_line_2 }}</a></p>
            {%- else -%}
              <p>{{ section.settings.address_line_1 }}</p>
              <p>{{ section.settings.address_line_2 }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="info-block">
          <a href="mailto:{{ section.settings.email_1 }}" class="icon-circle-link">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" class="icon-line"><path d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              <div class="notification-dot">
                <svg viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" fill="#e53e3e" stroke="white" stroke-width="1"/></svg>
              </div>
            </div>
          </a>
          <div class="info-text">
            <p><a href="mailto:{{ section.settings.email_1 }}">{{ section.settings.email_1 }}</a></p>
            <p><a href="mailto:{{ section.settings.email_2 }}">{{ section.settings.email_2 }}</a></p>
          </div>
        </div>

        <div class="info-block">
          <a href="tel:{{ section.settings.phone_1 }}" class="icon-circle-link">
            <div class="icon-circle">
              <svg viewBox="0 0 24 24" fill="none" class="icon-line"><path d="M22 16.92V19.92C22.0032 20.1986 21.9441 20.4735 21.8271 20.7245C21.7101 20.9754 21.5381 21.1962 21.324 21.3714C21.1098 21.5467 20.859 21.672 20.5896 21.7383C20.3201 21.8045 20.0388 21.81 19.76 21.75C16.6214 20.8315 13.7371 19.1678 11.37 16.92C9.11765 14.6546 7.53177 11.8906 6.74 8.85002C6.6806 8.57392 6.68656 8.29524 6.75738 8.02713C6.8282 7.75902 6.96272 7.50577 7.15423 7.28859C7.34574 7.07141 7.59107 6.8966 7.8785 6.77803C8.16593 6.65946 8.49002 6.59902 8.83 6.60002H11.83C12.295 6.59546 12.7483 6.76017 13.0886 7.05837C13.4289 7.35657 13.6269 7.7634 13.63 8.18002C13.6338 8.66317 13.7142 9.1415 13.86 9.58002C13.9928 9.99264 13.999 10.435 13.87 10.85L12.63 12.09C14.072 14.5168 15.9333 16.3781 18.36 17.82L19.6 16.58C19.96 16.22 20.43 16.03 20.92 16.06C21.3585 16.2058 21.8368 16.2862 22.32 16.29C22.793 16.29 23.242 16.47 23.57 16.81C23.9 17.15 24 17.6 24 18.06V21.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(-1.5, -1.5)"/></svg>
            </div>
          </a>
          <div class="info-text">
            <p><a href="tel:{{ section.settings.phone_1 }}">{{ section.settings.phone_1 }}</a></p>
            <p><a href="tel:{{ section.settings.phone_2 }}">{{ section.settings.phone_2 }}</a></p>
          </div>
        </div>
      </div>

      <div class="contact-form-layout">
        <div class="contact-form-container">
          {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus>{% render 'icon-success' %} {{ 'templates.contact.form.post_success' | t }}</div>
            {%- endif -%}
            
            <div class="contact-inquiry" style="margin-bottom: 20px;">
              <label class="form__label" for="ContactForm-inquiry" style="display: block; margin-bottom: 10px; font-weight: 600; font-size: 1.6rem;">How can we help?</label>
              <div class="dropdown-field">
                <select id="ContactForm-inquiry" class="custom-dropdown__select" name="contact[Inquiry Type]" required>
                  <option value="Product Inquiry" selected>Product Inquiry</option>
                  <option value="Order Status / Tracking">Order Status / Tracking</option>
                  <option value="Return or Exchange Request">Return or Exchange Request</option>
                  <option value="Report a Damaged Item">Report a Damaged Item</option>
                  <option value="Billing or Payment Issue">Billing or Payment Issue</option>
                  <option value="Bulk / Wholesale Request">Bulk / Wholesale Request</option>
                  <option value="Shipping Question">Shipping Question</option>
                  <option value="Other">Other</option>
                </select>
                <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                </svg>
              </div>
            </div>

            <div class="field field--with-error">
              <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}" required>
              <label class="field__label visually-hidden" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              <span class="asterisk">*</span>
            </div>

            <div class="field field--with-error">
              <input autocomplete="email" type="email" id="ContactForm-email" class="field__input" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" placeholder="{{ 'templates.contact.form.email' | t }}" required>
              <label class="field__label visually-hidden" for="ContactForm-email">{{ 'templates.contact.form.email' | t }}</label>
              <span class="asterisk">*</span>
            </div>

            <div class="field field--with-error comment-content">
              <textarea rows="7" id="ContactForm-body" class="text-area field__input" name="contact[{{ 'templates.contact.form.comment' | t }}]" placeholder="{{ 'templates.contact.form.comment' | t }}" required>{{- form.body -}}</textarea>
              <label class="form__label field__label visually-hidden" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
              <span class="asterisk">*</span>
            </div>

            <div class="newsletter-checkbox">
              <label>
                <input type="checkbox" name="checkbox" id="agree" onclick="agreeTerms()" value="check">
                <span>{{ section.settings.terms_text_prefix }} <a href="{{ section.settings.terms_link | default: '#' }}" class="term">{{ section.settings.terms_text_link }}</a></span>
              </label>
            </div> 

            <div class="contact__button">
              <button type="submit" class="button btn-style510" id="Subscribe" disabled>
                {{ section.settings.button_label | default: 'SUBMIT NOW' }}
              </button>
            </div>
          {%- endform -%}
        </div>

        <div class="contact-image-container">
          {%- if section.settings.contact_image != blank -%}
            <img 
              src="{{ section.settings.contact_image | image_url: width: 1500 }}"
              alt="{{ section.settings.contact_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.contact_image.width }}"
              height="{{ section.settings.contact_image.height }}"
              class="contact-image"
            >
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg contact-image' }}
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>
</div>

<script>
  function agreeTerms() {
    var submitBtn = document.getElementById("Subscribe");
    var checkConds = document.getElementById("agree");
    if (checkConds.checked == true) {
      submitBtn.disabled = false;
    } else {
      submitBtn.disabled = true;
    }
  }
</script>

{% schema %}
{
  "name": "Contact Form Match",
  "tag": "section",
  "class": "section form-image",
  "settings": [
    {
      "type": "checkbox",
      "id": "page_full_width",
      "default": false,
      "label": "Full Width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Title (Optional)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Contact Info Blocks"
    },
    {
      "type": "text",
      "id": "address_line_1",
      "label": "Address Line 1",
      "default": "No: 58 A, East Madison Street,"
    },
    {
      "type": "text",
      "id": "address_line_2",
      "label": "Address Line 2",
      "default": "Baltimore, MD, USA 4508"
    },
    {
      "type": "url",
      "id": "address_url",
      "label": "Address Link (e.g. Google Maps URL)"
    },
    {
      "type": "text",
      "id": "email_1",
      "label": "Email 1",
      "default": "info@example.com"
    },
    {
      "type": "text",
      "id": "email_2",
      "label": "Email 2",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "phone_1",
      "label": "Phone 1",
      "default": "000 - 123 - 456789"
    },
    {
      "type": "text",
      "id": "phone_2",
      "label": "Phone 2",
      "default": "0000 1234 56789"
    },
    {
      "type": "image_picker",
      "id": "contact_image",
      "label": "Contact Image"
    },
    {
      "type": "header",
      "content": "Form Text & Buttons"
    },
    {
      "type": "text",
      "id": "terms_text_prefix",
      "label": "Terms Prefix Text",
      "default": "I agree with the"
    },
    {
      "type": "text",
      "id": "terms_text_link",
      "label": "Terms Link Text",
      "default": "terms & conditions"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms Link URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SUBMIT NOW"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Contact Form Match"
    }
  ]
}
{% endschema %}
