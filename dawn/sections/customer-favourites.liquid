{% schema %}
{
  "name": "Customer Favourites",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Favourites"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show Per Tab",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "category_pill",
      "name": "Category Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Pick the collection whose products will show under this tab"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Favourites",
      "blocks": [
        { "type": "category_pill", "settings": { "label": "Food Containers" } },
        { "type": "category_pill", "settings": { "label": "Cups & Lids" } },
        { "type": "category_pill", "settings": { "label": "Plates & Bowls" } },
        { "type": "category_pill", "settings": { "label": "Cutlery & Napkins" } },
        { "type": "category_pill", "settings": { "label": "Carry Bags & Packaging" } },
        { "type": "category_pill", "settings": { "label": "Eco Friendly" } }
      ]
    }
  ]
}
{% endschema %}

{{ 'customer-favourites.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- assign products_limit = section.settings.products_to_show -%}

<div class="section-{{ section.id }}-padding most-ordered-section">
  <div class="most-ordered-container">
    <h2 class="most-ordered-heading">{{ section.settings.heading | escape }}</h2>

    <!-- Category Pill Tabs -->
    <div class="most-ordered-pills" id="cf-pills-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="category-pill {% if forloop.first %}active{% endif %}"
          data-tab-index="{{ forloop.index0 }}"
          data-section-id="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>

    <!-- Tab Content: one product grid per pill -->
    {%- for block in section.blocks -%}
      <div
        class="most-ordered-grid cf-tab-content"
        data-tab-index="{{ forloop.index0 }}"
        style="{% unless forloop.first %}display:none;{% endunless %}"
        id="cf-grid-{{ section.id }}-{{ forloop.index0 }}"
      >
        {%- if block.settings.collection != blank -%}
          {%- for product in block.settings.collection.products limit: products_limit -%}
            <div class="mo-product-card">
              <div class="mo-image-wrapper">
                {%- if product.available == false -%}
                  <span class="mo-badge mo-badge--sold-out">SOLD OUT</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="mo-badge">BEST SELLER</span>
                {%- endif -%}

                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    class="mo-product-image"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {%- else -%}
                  <img src="{{ 'box.png' | asset_url }}" alt="{{ product.title | escape }}" class="mo-product-image" loading="lazy">
                {%- endif -%}
              </div>

              <div class="mo-card-content">
                <div class="mo-rating-row">
                  <div class="mo-stars">
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                    <span class="star filled">★</span>
                  </div>
                  <span class="mo-reviews">25 Reviews</span>
                </div>

                <h3 class="mo-product-title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>
                <p class="mo-product-description">{{ product.description | strip_html | truncate: 80 }}</p>

                <div class="mo-price-row">
                  <div class="price-group">
                    <span class="mo-price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="mo-compare-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  {%- if product.metafields.custom.unit_text != blank -%}
                    <span class="mo-unit-text">{{ product.metafields.custom.unit_text }}</span>
                  {%- endif -%}
                </div>

                <button class="mo-add-btn" type="button">ADD TO CART</button>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Placeholder cards when no collection is assigned {%- endcomment -%}
          {%- for i in (1..products_limit) -%}
            <div class="mo-product-card">
              <div class="mo-image-wrapper">
                <span class="mo-badge">BEST SELLER</span>
                <img src="{{ 'box.png' | asset_url }}" alt="Placeholder product" class="mo-product-image" loading="lazy">
              </div>
              <div class="mo-card-content">
                <div class="mo-rating-row">
                  <div class="mo-stars">
                    <span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span>
                  </div>
                  <span class="mo-reviews">25 Reviews</span>
                </div>
                <h3 class="mo-product-title">28oz Rectangle Plastic Container</h3>
                <p class="mo-product-subtitle">Salads, hot grains, takeaway</p>
                <div class="mo-price-row">
                  <div class="price-group">
                    <span class="mo-price">$25.02</span>
                    <span class="mo-compare-price">$28.03</span>
                  </div>
                  <span class="mo-unit-text">150PCS/CARTON</span>
                </div>
                <button class="mo-add-btn" type="button">ADD TO CART</button>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var pillsContainer = document.getElementById('cf-pills-' + sectionId);
    if (!pillsContainer) return;

    pillsContainer.addEventListener('click', function(e) {
      var pill = e.target.closest('.category-pill');
      if (!pill) return;

      // Update active pill
      pillsContainer.querySelectorAll('.category-pill').forEach(function(p) {
        p.classList.remove('active');
      });
      pill.classList.add('active');

      var tabIndex = pill.getAttribute('data-tab-index');

      // Show/hide tab grids
      var section = pill.closest('.most-ordered-section');
      section.querySelectorAll('.cf-tab-content').forEach(function(grid) {
        if (grid.getAttribute('data-tab-index') === tabIndex) {
          grid.style.display = '';
        } else {
          grid.style.display = 'none';
        }
      });
    });
  })();
</script>
