{% # theme-check-disable %}
{% schema %}
{
  "name": "Custom Circle Menu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Menu"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F6FEFD"
    }
  ],
  "blocks": [
    {
      "type": "circle_menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Menu Item"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Circle Menu",
      "blocks": [
        {
          "type": "circle_menu_item",
          "settings": {
            "text": "Menu Item"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'custom-circle-menu.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-menu-navigation {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    padding: 0 10px;
    z-index: 10;
  }

  .nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #fff;
    border: 2px solid #149B77;
    color: #149B77;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
    pointer-events: all;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .nav-btn:hover {
    background-color: #149B77;
    color: #fff;
  }

  .nav-btn svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .nav-btn {
      width: 28px;
      height: 28px;
    }

    .nav-btn svg {
      width: 14px;
      height: 14px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }}-padding">
  <div class="custom-menu-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-menu-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="custom-menu-grid" id="customMenuScroll-{{ section.id }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="custom-menu-item" {{ block.shopify_attributes }}>
          <div class="custom-menu-icon">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag: loading: 'lazy', class: 'custom-menu-image'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="custom-menu-text">{{ block.settings.text | escape }}</span>
        </a>
      {%- endfor -%}
    </div>

    <div class="custom-menu-navigation">
      <button
        class="nav-btn prev-btn"
        aria-label="Previous"
        data-scroll-dir="-1"
        data-scroll-target="customMenuScroll-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        class="nav-btn next-btn"
        aria-label="Next"
        data-scroll-dir="1"
        data-scroll-target="customMenuScroll-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  if (!window.__circleMenuNavInit) {
    window.__circleMenuNavInit = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-scroll-dir]');
      if (!btn) return;
      var targetId = btn.getAttribute('data-scroll-target');
      var direction = parseInt(btn.getAttribute('data-scroll-dir'), 10);
      var container = document.getElementById(targetId);
      if (!container) return;
      var item = container.querySelector('.custom-menu-item');
      if (!item) return;
      var gap = parseFloat(window.getComputedStyle(container).gap) || 24;
      var amount = (item.offsetWidth + gap) * direction;
      container.scrollBy({ left: amount, behavior: 'smooth' });
    });
  }
</script>
