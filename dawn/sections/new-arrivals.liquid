{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
       "type": "text",
       "id": "btn_text",
       "label": "Button Text (Add to Cart)",
       "default": "ADD TO CART"
    },
    {
       "type": "text",
       "id": "sold_out_text",
       "label": "Button Text (Sold Out)",
       "default": "SOLD OUT"
    }
  ],
  "blocks": [
    {
      "type": "na_product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "BEST SELLER"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "28oz Rectangle Plastic Container"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Salads, hot grains, takeaway"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "number",
          "id": "reviews",
          "label": "Review Count",
          "default": 25
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$25.02"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "$28.03"
        },
        {
          "type": "text",
          "id": "unit_text",
          "label": "Unit Text",
          "default": "150PCS/BOX"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select a product to enable add-to-cart functionality"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals",
      "blocks": [
        { "type": "na_product_card" },
        { "type": "na_product_card" },
        { "type": "na_product_card" },
        { "type": "na_product_card" }
      ]
    }
  ]
}
{% endschema %}

{{ 'new-arrivals.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }}-padding new-arrivals-section">
  <div class="new-arrivals-container">
    <h2 class="new-arrivals-heading">{{ section.settings.heading | escape }}</h2>

    <div class="new-arrivals-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'na_product_card' -%}
          <div class="na-product-card" {{ block.shopify_attributes }}>
            <div class="na-image-wrapper">
              {%- if block.settings.badge_text != blank -%}
                <span class="na-badge">{{ block.settings.badge_text }}</span>
              {%- endif -%}
              
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: class: 'na-product-image', loading: 'lazy' }}
              {%- else -%}
                <img src="{{ 'box.png' | asset_url }}" alt="{{ block.settings.title }}" class="na-product-image" loading="lazy">
              {%- endif -%}
            </div>

            <div class="na-card-content">
              <div class="na-rating-row">
                <div class="na-stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      <span class="star filled">★</span>
                    {%- else -%}
                      <span class="star empty">★</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <span class="na-reviews">{{ block.settings.reviews }} Reviews</span>
              </div>

              <h3 class="na-product-title">{{ block.settings.title | escape }}</h3>
              <p class="na-product-subtitle">{{ block.settings.subtitle | escape }}</p>

              <div class="na-price-row">
                <div class="price-group">
                  <span class="na-price">{{ block.settings.price }}</span>
                  {%- if block.settings.compare_price != blank -%}
                    <span class="na-compare-price">{{ block.settings.compare_price }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.unit_text != blank -%}
                  <span class="na-unit-text">{{ block.settings.unit_text }}</span>
                {%- endif -%}
              </div>

              <button 
                class="na-add-btn"
                type="button"
                {% if block.settings.product != blank %}
                  data-product-id="{{ block.settings.product.id }}"
                  data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id }}"
                  {% unless block.settings.product.available %}disabled{% endunless %}
                {% endif %}
              >
                {% if block.settings.product != blank and block.settings.product.available == false %}
                  {{ section.settings.sold_out_text }}
                {% else %}
                  {{ section.settings.btn_text }}
                {% endif %}
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function() {
    // Add to cart functionality for new-arrivals section
    document.addEventListener('click', function(e) {
      var addBtn = e.target.closest('.na-add-btn');
      if (!addBtn || addBtn.disabled) return;

      e.preventDefault();
      
      var variantId = addBtn.getAttribute('data-variant-id');
      if (!variantId) return;

      // Disable button and show loading state
      addBtn.disabled = true;
      var originalText = addBtn.textContent;
      addBtn.textContent = 'ADDING...';

      // Prepare form data with sections for proper cart drawer rendering
      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', 1);
      formData.append('sections', 'cart-drawer,cart-icon-bubble');
      formData.append('sections_url', window.location.pathname);

      // Add to cart via Shopify Ajax API
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        return response.json();
      })
      .then(function(data) {
        console.log('✓ Successfully added to cart:', data);
        console.log('✓ Sections returned:', data.sections ? 'YES' : 'NO');
        
        // Success - show feedback
        addBtn.textContent = 'ADDED ✓';
        addBtn.classList.add('na-add-btn--added');
        
        // Update cart drawer HTML if sections are returned
        if (data.sections) {
          console.log('✓ Processing sections...');
          
          // Update cart drawer content
          if (data.sections['cart-drawer']) {
            console.log('✓ cart-drawer section exists');
            var cartDrawerElement = document.getElementById('CartDrawer');
            console.log('✓ Current CartDrawer element:', cartDrawerElement);
            
            if (cartDrawerElement) {
              var parser = new DOMParser();
              var doc = parser.parseFromString(data.sections['cart-drawer'], 'text/html');
              var newContent = doc.getElementById('CartDrawer');
              console.log('✓ Parsed new CartDrawer element:', newContent);
              
              if (newContent) {
                console.log('✓ Updating innerHTML...');
                cartDrawerElement.innerHTML = newContent.innerHTML;
                console.log('✓ innerHTML updated successfully');
                
                // Remove is-empty class from cart-drawer element
                var cartDrawer = document.querySelector('cart-drawer');
                console.log('✓ cart-drawer element:', cartDrawer);
                console.log('✓ Has is-empty class before:', cartDrawer ? cartDrawer.classList.contains('is-empty') : 'N/A');
                
                if (cartDrawer) {
                  cartDrawer.classList.remove('is-empty');
                  console.log('✓ Has is-empty class after:', cartDrawer.classList.contains('is-empty'));
                }
                
                // Also remove is-empty from cart-drawer-items
                var cartDrawerItems = document.querySelector('cart-drawer-items');
                if (cartDrawerItems) {
                  cartDrawerItems.classList.remove('is-empty');
                  console.log('✓ Removed is-empty from cart-drawer-items');
                }
              } else {
                console.error('✗ Could not find CartDrawer in parsed HTML');
              }
            } else {
              console.error('✗ Could not find CartDrawer element on page');
            }
          } else {
            console.error('✗ cart-drawer section not in response');
          }
          
          // Update cart count bubble (not the entire icon)
          if (data.sections['cart-icon-bubble']) {
            console.log('✓ cart-icon-bubble section exists');
            var parser = new DOMParser();
            var doc = parser.parseFromString(data.sections['cart-icon-bubble'], 'text/html');
            var newCountBubble = doc.querySelector('.cart-count-bubble');
            var currentButton = document.querySelector('#cart-icon-bubble');
            console.log('✓ New count bubble from section:', newCountBubble);
            console.log('✓ Current cart button:', currentButton);
            
            if (currentButton) {
              // Find or create the cart-count-bubble div
              var currentCountBubble = currentButton.querySelector('.cart-count-bubble');
              
              if (newCountBubble) {
                // If new count bubble exists, update or create it
                if (currentCountBubble) {
                  currentCountBubble.innerHTML = newCountBubble.innerHTML;
                  console.log('✓ Updated existing cart count bubble');
                } else {
                  currentButton.appendChild(newCountBubble.cloneNode(true));
                  console.log('✓ Added new cart count bubble');
                }
              } else if (currentCountBubble) {
                // If no new bubble (cart empty), remove the old one
                currentCountBubble.remove();
                console.log('✓ Removed cart count bubble (cart empty)');
              }
            } else {
              console.error('✗ Could not find cart button');
            }
          } else {
            console.error('✗ cart-icon-bubble section not in response');
          }
        }
        
        console.log('✓ Opening cart drawer in 500ms...');
        // Open cart drawer
        setTimeout(function() {
          var cartIconBubble = document.querySelector('#cart-icon-bubble');
          if (cartIconBubble) {
            cartIconBubble.click();
          }
        }, 500);

        // Reset button after 2 seconds
        setTimeout(function() {
          addBtn.disabled = false;
          addBtn.classList.remove('na-add-btn--added');
          addBtn.textContent = originalText;
        }, 2000);
      })
      .catch(function(error) {
        console.error('Error adding to cart:', error);
        addBtn.textContent = 'ERROR';
        setTimeout(function() {
          addBtn.disabled = false;
          addBtn.textContent = originalText;
        }, 2000);
      });
    });
  })();
</script>
