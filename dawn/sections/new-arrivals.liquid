{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "header",
      "content": "Product Source"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Content Source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "products", "label": "Select Products" }
      ],
      "default": "collection",
      "info": "Choose where to get products from"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Pick the collection whose products will show (when Content Source is Collection)"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "Select specific products to show (when Content Source is Select Products)",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Style"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button Text"
    },
    {
       "type": "text",
       "id": "btn_text",
       "label": "Button Text (Add to Cart)",
       "default": "ADD TO CART"
    },
    {
       "type": "text",
       "id": "sold_out_text",
       "label": "Button Text (Sold Out)",
       "default": "SOLD OUT"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}

{{ 'new-arrivals.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- assign products_limit = section.settings.products_to_show -%}

{%- liquid
  assign products_to_display = null
  if section.settings.content_source == 'collection' and section.settings.collection != blank
    assign products_to_display = section.settings.collection.products
  elsif section.settings.content_source == 'products' and section.settings.product_list != blank
    assign products_to_display = section.settings.product_list
  endif
-%}

<div class="section-{{ section.id }}-padding new-arrivals-section">
  <div class="new-arrivals-container">
    <h2 class="new-arrivals-heading">{{ section.settings.heading | escape }}</h2>

    <div class="new-arrivals-grid">
      {%- if products_to_display != null and products_to_display.size > 0 -%}
        {%- for product in products_to_display limit: products_limit -%}
          <div class="na-product-card">
            <div class="na-image-wrapper">
              {%- if product.available == false -%}
                <span class="na-badge na-badge--sold-out">SOLD OUT</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="na-badge">BEST SELLER</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  class="na-product-image"
                  loading="lazy"
                >
              {%- else -%}
                <img src="{{ 'box.png' | asset_url }}" alt="{{ product.title | escape }}" class="na-product-image" loading="lazy">
              {%- endif -%}
            </div>

            <div class="na-card-content">
              <div class="na-rating-row">
                <div class="na-stars">
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                </div>
                <span class="na-reviews">25 Reviews</span>
              </div>

              <h3 class="na-product-title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <p class="na-product-subtitle">{{ product.description | strip_html | truncate: 80 }}</p>

              <div class="na-price-row">
                <div class="price-group">
                  <span class="na-price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="na-compare-price">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
                {%- if product.metafields.custom.box_size != blank -%}
                  <span class="na-unit-text">{{ product.metafields.custom.box_size }}</span>
                {%- endif -%}
              </div>

              <button 
                class="na-add-btn" 
                type="button"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                {% unless product.available %}disabled{% endunless %}
              >
                {% if product.available %}{{ section.settings.btn_text }}{% else %}{{ section.settings.sold_out_text }}{% endif %}
              </button>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards when no products are available {%- endcomment -%}
        {%- for i in (1..products_limit) -%}
          <div class="na-product-card">
            <div class="na-image-wrapper">
              <span class="na-badge">BEST SELLER</span>
              <img src="{{ 'box.png' | asset_url }}" alt="Placeholder product" class="na-product-image" loading="lazy">
            </div>
            <div class="na-card-content">
              <div class="na-rating-row">
                <div class="na-stars">
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                  <span class="star filled">★</span>
                </div>
                <span class="na-reviews">25 Reviews</span>
              </div>
              <h3 class="na-product-title">Product Title</h3>
              <p class="na-product-subtitle">Product description goes here</p>
              <div class="na-price-row">
                <div class="price-group">
                  <span class="na-price">$25.02</span>
                  <span class="na-compare-price">$28.03</span>
                </div>
                <span class="na-unit-text">150PCS/BOX</span>
              </div>
              <button class="na-add-btn" type="button" disabled>{{ section.settings.btn_text }}</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    // Add to cart functionality for new-arrivals section
    document.addEventListener('click', function(e) {
      var addBtn = e.target.closest('.na-add-btn');
      if (!addBtn || addBtn.disabled) return;

      e.preventDefault();
      
      var variantId = addBtn.getAttribute('data-variant-id');
      if (!variantId) return;

      // Disable button and show loading state
      addBtn.disabled = true;
      var originalText = addBtn.textContent;
      addBtn.textContent = 'ADDING...';

      // Prepare form data with sections for proper cart drawer rendering
      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', 1);
      formData.append('sections', 'cart-drawer,cart-icon-bubble');
      formData.append('sections_url', window.location.pathname);

      // Add to cart via Shopify Ajax API
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        return response.json();
      })
      .then(function(data) {
        // Success - show feedback
        addBtn.textContent = 'ADDED ✓';
        addBtn.classList.add('na-add-btn--added');
        
        // Update cart drawer HTML if sections are returned
        if (data.sections) {
          // Update cart drawer content
          if (data.sections['cart-drawer']) {
            var cartDrawerElement = document.getElementById('CartDrawer');
            if (cartDrawerElement) {
              var parser = new DOMParser();
              var doc = parser.parseFromString(data.sections['cart-drawer'], 'text/html');
              var newContent = doc.getElementById('CartDrawer');
              if (newContent) {
                cartDrawerElement.innerHTML = newContent.innerHTML;
                var cartDrawer = document.querySelector('cart-drawer');
                if (cartDrawer) cartDrawer.classList.remove('is-empty');
                var cartDrawerItems = document.querySelector('cart-drawer-items');
                if (cartDrawerItems) cartDrawerItems.classList.remove('is-empty');
              }
            }
          }
          
          // Update cart count bubble
          if (data.sections['cart-icon-bubble']) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(data.sections['cart-icon-bubble'], 'text/html');
            var newCountBubble = doc.querySelector('.cart-count-bubble');
            var currentButton = document.querySelector('#cart-icon-bubble');
            if (currentButton) {
              var currentCountBubble = currentButton.querySelector('.cart-count-bubble');
              if (newCountBubble) {
                if (currentCountBubble) {
                  currentCountBubble.innerHTML = newCountBubble.innerHTML;
                } else {
                  currentButton.appendChild(newCountBubble.cloneNode(true));
                }
              } else if (currentCountBubble) {
                currentCountBubble.remove();
              }
            }
          }
        }
        
        // Open cart drawer
        setTimeout(function() {
          var cartIconBubble = document.querySelector('#cart-icon-bubble');
          if (cartIconBubble) cartIconBubble.click();
        }, 500);

        // Reset button after 2 seconds
        setTimeout(function() {
          addBtn.disabled = false;
          addBtn.classList.remove('na-add-btn--added');
          addBtn.textContent = originalText;
        }, 2000);
      })
      .catch(function(error) {
        console.error('Error adding to cart:', error);
        addBtn.textContent = 'ERROR';
        setTimeout(function() {
          addBtn.disabled = false;
          addBtn.textContent = originalText;
        }, 2000);
      });
    });
  })();
</script>
