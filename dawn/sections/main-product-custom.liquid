{% comment %}theme-check-disable UnknownObject, AssetUrlFilters, DeprecatedFilter, ImgWidthAndHeight{% endcomment %}
{{ 'main-product-custom.css' | asset_url | stylesheet_tag }}
<style>
  :root {
    --font-body-family: 'Rethink Sans', sans-serif !important;
    --font-heading-family: 'Rethink Sans', sans-serif !important;
  }
</style>
<!-- Main Product Custom Section -->

<div class="main-product-custom">
  <div class="product-container">
    <!-- Left Column: Images -->
    <div class="product-gallery">
      <div class="main-image-container">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="main-image"
            id="MainImage"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'main-image' }}
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="thumbnail-list">
          {% for image in product.images limit: 4 %}
            <div
              class="thumbnail-item {% if forloop.first %}active{% endif %}"
              onclick="changeImage('{{ image | image_url: width: 1200 }}', this)"
            >
              <img
                src="{{ image | image_url: width: 400 }}"
                alt="{{ image.alt | escape }}"
                class="thumbnail-image"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Info -->
    <div class="product-info">
      <div class="reviews-stars">
        <div class="stars">
          {% for i in (1..5) %}
            <span class="star-icon">★</span>
          {% endfor %}
        </div>
        <span class="review-count">25 Reviews</span>
      </div>

      <span class="vendor-sku">
        {{- product.vendor }} | SKU: {{ product.selected_or_first_available_variant.sku -}}
      </span>

      <h1 class="product-title">{{ product.title }}</h1>

      {% if product.metafields.custom.ideal_for != blank %}
        <div class="ideal-for">{{ product.metafields.custom.ideal_for.value }}</div>
      {% endif %}

      <div class="price-container">
        <span class="current-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="compare-price">{{ product.compare_at_price | money }}</span>
          <span class="discount-badge">
            {{
              product.compare_at_price
              | minus: product.price
              | times: 100.0
              | divided_by: product.compare_at_price
              | round
            -}}
            % OFF
          </span>
        {% endif %}
      </div>

      {% if product.metafields.custom.box_size != blank %}
        <span class="unit-price-label">{{ product.metafields.custom.box_size.value }}</span>
      {% endif %}

      {% assign feature_icons = product.metafields.custom.feature_icons.value %}
      {% assign feature_labels = product.metafields.custom.feature_labels.value %}
      {% if feature_icons != blank and feature_icons.size > 0 %}
        <div class="feature-icons-grid">
          {% for icon in feature_icons %}
            <div class="feature-item">
              <img
                src="{{ icon | image_url: width: 130 }}"
                alt="{{ feature_labels[forloop.index0] | default: 'Feature' | escape }}"
                class="feature-icon-img"
                loading="lazy"
                width="130"
                height="130"
              >
              {% if feature_labels != blank and feature_labels[forloop.index0] != blank %}
                <span class="feature-label">{{ feature_labels[forloop.index0] }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="actions-row">
          <div>
            <label class="quantity-label" for="Quantity">Quantity</label>
            <div class="qty-selector">
              <button type="button" class="qty-btn minus" onclick="updateQty(-1)">-</button>
              <div class="qty-circle"></div>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" class="qty-input">
              <div class="qty-circle-plus"></div>
              <button type="button" class="qty-btn plus" onclick="updateQty(1)">+</button>
            </div>
          </div>

          <button type="submit" name="add" class="add-to-cart-btn">
            {{ section.settings.add_to_cart_text }}
          </button>
        </div>
      {% endform %}

      <div class="shipping-info">
        <div class="shipping-item">
          {% if section.settings.shipping_icon_1 != blank %}
            {{ section.settings.shipping_icon_1 | image_url: width: 24 | image_tag: class: 'shipping-icon' }}
          {% endif %}

          <div>
            <div class="shipping-text-primary">{{ section.settings.shipping_heading_1 }}</div>
            <div class="shipping-text-secondary">{{ section.settings.shipping_text_1 }}</div>
            <a href="{{ section.settings.shipping_link_url_1 | default: '#' }}" class="shipping-link">
              {{- section.settings.shipping_link_text_1 -}}
            </a>
          </div>
        </div>

        <div class="shipping-item">
          {% if section.settings.shipping_icon_2 != blank %}
            {{ section.settings.shipping_icon_2 | image_url: width: 24 | image_tag: class: 'shipping-icon' }}
          {% endif %}
          <div>
            <div class="shipping-text-primary">{{ section.settings.shipping_heading_2 }}</div>
            <div class="shipping-text-secondary">{{ section.settings.shipping_text_2 }}</div>
            <a href="{{ section.settings.shipping_link_url_2 | default: '#' }}" class="shipping-link">
              {{- section.settings.shipping_link_text_2 -}}
            </a>
          </div>
        </div>
      </div>

      <!-- Frequently Bought Together Section -->
      {% assign fbt_collection = product.collections.first %}
      {% if fbt_collection != blank %}
        <div class="fbt-container">
          {% if section.settings.fbt_heading != blank %}
            <h3 class="fbt-heading">{{ section.settings.fbt_heading }}</h3>
          {% endif %}

          <div class="fbt-list">
            {% assign fbt_count = 0 %}
            {% for col_product in fbt_collection.products %}
              {% if col_product.id == product.id %}
                {% continue %}
              {% endif %}
              {% if fbt_count >= 2 %}
                {% break %}
              {% endif %}

              <div class="fbt-item">
                <div class="fbt-image-wrapper">
                  {% if col_product.featured_image %}
                    <img
                      src="{{ col_product.featured_image | image_url: width: 200, height: 200, crop: 'center' }}"
                      alt="{{ col_product.title | escape }}"
                      class="fbt-item-image"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'fbt-item-image' }}
                  {% endif %}
                </div>

                <div class="fbt-item-info">
                  <a href="{{ col_product.url }}" class="fbt-item-title">{{ col_product.title }}</a>

                  {% if col_product.metafields.custom.ideal_for != blank %}
                    <div class="fbt-ideal-for">{{ col_product.metafields.custom.ideal_for.value }}</div>
                  {% endif %}

                  <div class="fbt-item-price-row">
                    <span class="fbt-item-price">{{ col_product.price | money }}</span>
                    {% if col_product.compare_at_price > col_product.price %}
                      <span class="fbt-item-compare-price">{{ col_product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>

                <div class="fbt-item-action">
                  <button
                    type="button"
                    class="fbt-add-btn"
                    data-variant-id="{{ col_product.selected_or_first_available_variant.id }}"
                    onclick="addFbtToCart(this)"
                  >
                    ADD +
                  </button>
                </div>
              </div>

              {% assign fbt_count = fbt_count | plus: 1 %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function changeImage(src, element) {
    document.getElementById('MainImage').src = src;
    document.querySelectorAll('.thumbnail-item').forEach((el) => el.classList.remove('active'));
    element.classList.add('active');
  }

  function updateQty(change) {
    const input = document.getElementById('Quantity');
    let value = parseInt(input.value);
    value += change;
    if (value < 1) value = 1;
    input.value = value;
  }

  function addFbtToCart(button) {
    const variantId = button.getAttribute('data-variant-id');
    const originalText = button.textContent;
    button.textContent = 'Adding...';
    button.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] }),
    })
      .then((response) => response.json())
      .then((data) => {
        button.textContent = 'Added ✓';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1500);
      })
      .catch((error) => {
        button.textContent = originalText;
        button.disabled = false;
        console.error('Error adding to cart:', error);
      });
  }
</script>

{% schema %}
{
  "name": "Main Product Custom",
  "settings": [
    {
      "type": "text",
      "id": "sku_prefix",
      "label": "SKU Prefix",
      "default": "Resto Supply Hub | SKU: "
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Shipping Info 1"
    },
    {
      "type": "image_picker",
      "id": "shipping_icon_1",
      "label": "Icon 1"
    },
    {
      "type": "text",
      "id": "shipping_heading_1",
      "label": "Heading 1",
      "default": "Estimated Arrival"
    },
    {
      "type": "text",
      "id": "shipping_text_1",
      "label": "Text 1",
      "default": "Tracked delivery: 1 - 3 business days"
    },
    {
      "type": "text",
      "id": "shipping_link_text_1",
      "label": "Link Text 1",
      "default": "View Shipping Options"
    },
    {
      "type": "url",
      "id": "shipping_link_url_1",
      "label": "Link URL 1"
    },
    {
      "type": "header",
      "content": "Shipping Info 2"
    },
    {
      "type": "image_picker",
      "id": "shipping_icon_2",
      "label": "Icon 2"
    },
    {
      "type": "text",
      "id": "shipping_heading_2",
      "label": "Heading 2",
      "default": "Pickup available"
    },
    {
      "type": "text",
      "id": "shipping_text_2",
      "label": "Text 2",
      "default": "349 Bowes Rd. Usually ready in 24 hours"
    },
    {
      "type": "text",
      "id": "shipping_link_text_2",
      "label": "Link Text 2",
      "default": "View Store Information"
    },
    {
      "type": "url",
      "id": "shipping_link_url_2",
      "label": "Link URL 2"
    },
    {
      "type": "header",
      "content": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "fbt_heading",
      "label": "Frequently Bought Heading",
      "default": "Frequently Brought Together"
    }
  ]
}
{% endschema %}
