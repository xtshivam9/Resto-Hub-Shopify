{% comment %}theme-check-disable UnknownObject, AssetUrlFilters, DeprecatedFilter, ImgWidthAndHeight{% endcomment %}
{{ 'main-product-custom.css' | asset_url | stylesheet_tag }}
<style>
  :root {
    --font-body-family: 'Rethink Sans', sans-serif !important;
    --font-heading-family: 'Rethink Sans', sans-serif !important;
  }
</style>
<!-- Main Product Custom Section -->

<div class="main-product-custom">
  <div class="product-container">
    <!-- Left Column: Images -->
    <div class="product-gallery">
      <div class="main-image-container">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="main-image"
            id="MainImage"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'main-image' }}
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="thumbnail-list">
          {% for image in product.images limit: 4 %}
            <div
              class="thumbnail-item {% if forloop.first %}active{% endif %}"
              onclick="changeImage('{{ image | image_url: width: 1200 }}', this)"
            >
              <img
                src="{{ image | image_url: width: 400 }}"
                alt="{{ image.alt | escape }}"
                class="thumbnail-image"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Info -->
    <div class="product-info">

      <span class="vendor-sku">
        {{- product.vendor }} | SKU: {{ product.selected_or_first_available_variant.sku -}}
      </span>

      <h1 class="product-title">{{ product.title }}</h1>

      {% if product.metafields.custom.ideal_for != blank %}
        <div class="ideal-for">{{ product.metafields.custom.ideal_for.value }}</div>
      {% endif %}

      <div class="price-container">
        <span class="current-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="compare-price">{{ product.compare_at_price | money }}</span>
          <span class="discount-badge">
            {{
              product.compare_at_price
              | minus: product.price
              | times: 100.0
              | divided_by: product.compare_at_price
              | round
            -}}
            % OFF
          </span>
        {% endif %}
      </div>

      {% if product.metafields.custom.box_size != blank %}
        <span class="unit-price-label">{{ product.metafields.custom.box_size.value }}</span>
      {% endif %}

      {% assign feature_labels = product.metafields.custom.feature_labels.value %}
      {% assign feature_icon_count = 0 %}
      {% for i in (1..4) %}
        {% assign icon_setting = 'feature_icon_' | append: i %}
        {% if section.settings[icon_setting] != blank %}
          {% assign feature_icon_count = feature_icon_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if feature_icon_count > 0 %}
        <div class="feature-icons-grid">
          {% assign label_idx = 0 %}
          {% for i in (1..4) %}
            {% assign icon_setting = 'feature_icon_' | append: i %}
            {% assign icon = section.settings[icon_setting] %}
            {% if icon != blank %}
              {% assign current_label = feature_labels[label_idx] %}
              {% assign current_label_lower = current_label | downcase | strip %}
              {% unless current_label_lower == 'n/a' %}
                <div class="feature-item">
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ current_label | default: 'Feature' | escape }}"
                    class="feature-icon-img"
                      {% if label_idx == 0 %}style="width: 88px; height: 88px !important;"{% else %}style="width: 84px; height: 56px !important;"{% endif %}
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                  {% if feature_labels != blank and current_label != blank %}
                    <span class="feature-label">{{ current_label }}</span>
                  {% endif %}
                </div>
              {% endunless %}
              {% assign label_idx = label_idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="actions-row">
          <div>
            <label class="quantity-label" for="Quantity">Quantity</label>
            <div class="qty-selector">
              <button type="button" class="qty-btn minus" onclick="updateQty(-1)">-</button>
              <div class="qty-circle"></div>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" class="qty-input">
              <div class="qty-circle-plus"></div>
              <button type="button" class="qty-btn plus" onclick="updateQty(1)">+</button>
            </div>
          </div>

          <button type="submit" name="add" class="add-to-cart-btn">
            {{ section.settings.add_to_cart_text }}
          </button>
        </div>
      {% endform %}

      <div class="shipping-info">
        <div class="shipping-item">
          {% if section.settings.shipping_icon_1 != blank %}
            {{ section.settings.shipping_icon_1 | image_url: width: 100 | image_tag: class: 'shipping-icon' }}
          {% endif %}

          <div>
            <div class="shipping-text-primary">{{ section.settings.shipping_heading_1 }}</div>
            <div class="shipping-text-secondary">{{ section.settings.shipping_text_1 }}</div>
            <a href="{{ section.settings.shipping_link_url_1 | default: '#' }}" class="shipping-link">
              {{- section.settings.shipping_link_text_1 -}}
            </a>
          </div>
        </div>

        <div class="shipping-item">
          {% if section.settings.shipping_icon_2 != blank %}
            {{ section.settings.shipping_icon_2 | image_url: width: 100 | image_tag: class: 'shipping-icon' }}
          {% endif %}
          <div>
            <div class="shipping-text-primary">{{ section.settings.shipping_heading_2 }}</div>
            <div class="shipping-text-secondary">{{ section.settings.shipping_text_2 }}</div>
            <button type="button" class="shipping-link" onclick="openStoreInfoPopup()">
              {{- section.settings.shipping_link_text_2 -}}
            </button>
          </div>
        </div>
      </div>

      <!-- Frequently Bought Together Section -->
      {% assign fbt_collection = product.collections.first %}
      {% if fbt_collection != blank %}
        <div class="fbt-container">
          {% if section.settings.fbt_heading != blank %}
            <h3 class="fbt-heading">{{ section.settings.fbt_heading }}</h3>
          {% endif %}

          <div class="fbt-list">
            {% assign fbt_count = 0 %}
            {% for col_product in fbt_collection.products %}
              {% if col_product.id == product.id %}
                {% continue %}
              {% endif %}
              {% if fbt_count >= 2 %}
                {% break %}
              {% endif %}

              <div class="fbt-item">
                <div class="fbt-image-wrapper">
                  {% if col_product.featured_image %}
                    <img
                      src="{{ col_product.featured_image | image_url: width: 200, height: 200, crop: 'center' }}"
                      alt="{{ col_product.title | escape }}"
                      class="fbt-item-image"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'fbt-item-image' }}
                  {% endif %}
                </div>

                <div class="fbt-item-info">
                  <a href="{{ col_product.url }}" class="fbt-item-title">{{ col_product.title }}</a>

                  {% if col_product.metafields.custom.ideal_for != blank %}
                    <div class="fbt-ideal-for">{{ col_product.metafields.custom.ideal_for.value }}</div>
                  {% endif %}

                  <div class="fbt-item-price-row">
                    <span class="fbt-item-price">{{ col_product.price | money }}</span>
                    {% if col_product.compare_at_price > col_product.price %}
                      <span class="fbt-item-compare-price">{{ col_product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>

                <div class="fbt-item-action">
                  <button
                    type="button"
                    class="fbt-add-btn"
                    data-variant-id="{{ col_product.selected_or_first_available_variant.id }}"
                    onclick="addFbtToCart(this)"
                  >
                    ADD +
                  </button>
                </div>
              </div>

              {% assign fbt_count = fbt_count | plus: 1 %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function changeImage(src, element) {
    document.getElementById('MainImage').src = src;
    document.querySelectorAll('.thumbnail-item').forEach((el) => el.classList.remove('active'));
    element.classList.add('active');
  }

  function updateQty(change) {
    const input = document.getElementById('Quantity');
    let value = parseInt(input.value);
    value += change;
    if (value < 1) value = 1;
    input.value = value;
  }

  function openStoreInfoPopup() {
    var popup = document.getElementById('store-info-popup');
    if (popup) {
      popup.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeStoreInfoPopup() {
    var popup = document.getElementById('store-info-popup');
    if (popup) {
      popup.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeStoreInfoPopup();
  });

  function addFbtToCart(button) {
    var variantId = button.getAttribute('data-variant-id');
    if (!variantId) return;

    var originalText = button.textContent;
    button.textContent = 'Adding...';
    button.disabled = true;

    // Use FormData with sections for proper cart drawer rendering
    var formData = new FormData();
    formData.append('id', variantId);
    formData.append('quantity', 1);
    formData.append('sections', 'cart-drawer,cart-icon-bubble');
    formData.append('sections_url', window.location.pathname);

    fetch('/cart/add.js', {
      method: 'POST',
      body: formData,
    })
      .then(function (response) {
        if (!response.ok) {
          throw new Error('Failed to add to cart');
        }
        return response.json();
      })
      .then(function (data) {
        button.textContent = 'Added ✓';

        // Update cart drawer HTML if sections are returned
        if (data.sections) {
          if (data.sections['cart-drawer']) {
            var cartDrawerElement = document.getElementById('CartDrawer');
            if (cartDrawerElement) {
              var parser = new DOMParser();
              var doc = parser.parseFromString(data.sections['cart-drawer'], 'text/html');
              var newContent = doc.getElementById('CartDrawer');
              if (newContent) {
                cartDrawerElement.innerHTML = newContent.innerHTML;
                var cartDrawer = document.querySelector('cart-drawer');
                if (cartDrawer) cartDrawer.classList.remove('is-empty');
                var cartDrawerItems = document.querySelector('cart-drawer-items');
                if (cartDrawerItems) cartDrawerItems.classList.remove('is-empty');
              }
            }
          }

          // Update cart count bubble
          if (data.sections['cart-icon-bubble']) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(data.sections['cart-icon-bubble'], 'text/html');
            var newCountBubble = doc.querySelector('.cart-count-bubble');
            var currentButton = document.querySelector('#cart-icon-bubble');
            if (currentButton) {
              var currentCountBubble = currentButton.querySelector('.cart-count-bubble');
              if (newCountBubble) {
                if (currentCountBubble) {
                  currentCountBubble.innerHTML = newCountBubble.innerHTML;
                } else {
                  currentButton.appendChild(newCountBubble.cloneNode(true));
                }
              } else if (currentCountBubble) {
                currentCountBubble.remove();
              }
            }
          }
        }

        // Open cart drawer
        setTimeout(function () {
          var cartIconBubble = document.querySelector('#cart-icon-bubble');
          if (cartIconBubble) cartIconBubble.click();
        }, 500);

        // Reset button after 2 seconds
        setTimeout(function () {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      })
      .catch(function (error) {
        console.error('Error adding to cart:', error);
        button.textContent = 'ERROR';
        setTimeout(function () {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      });
  }
</script>

<!-- Store Info Popup -->
<div id="store-info-popup" class="store-popup-overlay" onclick="closeStoreInfoPopup()" role="dialog" aria-modal="true" aria-label="Store Information">
  <div class="store-popup-modal" onclick="event.stopPropagation()">
    <button type="button" class="store-popup-close" onclick="closeStoreInfoPopup()" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <h2 class="store-popup-title">Store Information</h2>

    <div class="store-popup-info-blocks">
      {% if section.settings.store_address_line_1 != blank or section.settings.store_address_line_2 != blank %}
        <div class="store-popup-info-row">
          <div class="store-popup-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 6.13401 7.02944 3 12 3C16.9706 3 21 6.13401 21 10Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
          </div>
          <div class="store-popup-info-text">
            {% if section.settings.store_address_line_1 != blank %}<p>{{ section.settings.store_address_line_1 }}</p>{% endif %}
            {% if section.settings.store_address_line_2 != blank %}<p>{{ section.settings.store_address_line_2 }}</p>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.store_email_1 != blank or section.settings.store_email_2 != blank %}
        <div class="store-popup-info-row">
          <div class="store-popup-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 6L12 13L2 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="store-popup-info-text">
            {% if section.settings.store_email_1 != blank %}<p><a href="mailto:{{ section.settings.store_email_1 }}">{{ section.settings.store_email_1 }}</a></p>{% endif %}
            {% if section.settings.store_email_2 != blank %}<p><a href="mailto:{{ section.settings.store_email_2 }}">{{ section.settings.store_email_2 }}</a></p>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.store_phone_1 != blank or section.settings.store_phone_2 != blank %}
        <div class="store-popup-info-row">
          <div class="store-popup-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 16.92V19.92C22.0032 20.4792 21.7931 21.0191 21.4135 21.4249C21.034 21.8307 20.5139 22.0727 19.96 22.1C16.4248 21.7856 13.0352 20.5342 10.12 18.47C7.40455 16.5791 5.11727 14.2919 3.22 11.58C1.14953 8.65124 0.897808 5.24284 0.59 1.69998C0.617693 1.14812 0.858218 0.629437 1.26219 0.249858C1.66616 -0.129721 2.20404 -0.339867 2.76 -0.32002H5.76C6.75067 -0.330267 7.59297 0.382738 7.76 1.36C7.89893 2.26454 8.1427 3.1497 8.48 4C8.75777 4.71674 8.57977 5.52684 8.03 6.07L6.79 7.30999C8.59064 10.1238 10.9162 12.4494 13.73 14.25L14.97 13.01C15.5152 12.4602 16.3253 12.2822 17.04 12.56C17.8903 12.8973 18.7755 13.1411 19.68 13.28C20.6726 13.4485 21.3909 14.3062 21.36 15.31L22 16.92Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(1, 1.5) scale(0.9)"/></svg>
          </div>
          <div class="store-popup-info-text">
            {% if section.settings.store_phone_1 != blank %}<p><a href="tel:{{ section.settings.store_phone_1 }}">{{ section.settings.store_phone_1 }}</a></p>{% endif %}
            {% if section.settings.store_phone_2 != blank %}<p><a href="tel:{{ section.settings.store_phone_2 }}">{{ section.settings.store_phone_2 }}</a></p>{% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {% if section.settings.store_map_embed_html != blank %}
      <div class="store-popup-map">
        {{ section.settings.store_map_embed_html }}
      </div>
    {% endif %}
  </div>
</div>

