{% schema %}
{
  "name": "Who We Serve (About)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who We Serve"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
       "type": "color",
       "id": "bg_color",
       "label": "Background Color",
       "default": "#F9FDFB"
    }
  ],
  "blocks": [
    {
      "type": "about_service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Service Name"
        },
        {
           "type": "image_picker",
           "id": "icon_image",
           "label": "Icon Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who We Serve (About)",
      "blocks": [
        {
          "type": "about_service_item",
          "settings": {
            "title": "Restaurants & QSRs"
          }
        },
        {
          "type": "about_service_item",
          "settings": {
            "title": "Cafés & Coffee Chains"
          }
        },
        {
          "type": "about_service_item",
          "settings": {
            "title": "Catering Companies"
          }
        },
        {
          "type": "about_service_item",
          "settings": {
            "title": "Food Trucks & Cloud Kitchens"
          }
        },
        {
          "type": "about_service_item",
          "settings": {
            "title": "Event Planners & Venues"
          }
        },
        {
          "type": "about_service_item",
          "settings": {
            "title": "Franchise & Multi-Location Brands"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .who-we-serve-about-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
    font-family: 'Rethink Sans', sans-serif;
  }

  .who-we-serve-about-heading {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 40px;
    font-weight: 600;
    margin-bottom: 4rem;
    color: #000; 
  }

  .who-we-serve-about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    justify-items: center;
  }

  .serve-about-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 190px; /* Reduced to force text wrap */
  }

  .serve-about-icon-wrapper {
    width: 100px; 
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    border: 3px solid #149B77; /* Reduced from 5px */
    border-radius: 50%;
    padding: 16px; /* Reduced from 22px to increase image size */
    transition: all 0.3s ease;
    background-color: #fff;
  }
  
  .serve-about-item:hover .serve-about-icon-wrapper {
    transform: scale(1.05);
    background-color: rgba(20, 155, 119, 0.05);
  }

  .serve-about-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  /* Ensure SVG color is green if controlling via CSS is needed, though usually in SVG itself */
  .serve-about-icon path {
      fill: #149B77;
  }


  .serve-about-title {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 18px; 
    font-weight: 600;
    line-height: 1.35;
    color: #000;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .who-we-serve-about-heading {
        font-size: 32px;
        margin-bottom: 3rem;
    }
    .who-we-serve-about-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .who-we-serve-about-wrapper {
        padding: 0 1.5rem;
    }
    .who-we-serve-about-heading {
        font-size: 28px;
        margin-bottom: 2rem;
    }
    .who-we-serve-about-grid {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 20px;
        padding-bottom: 10px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .who-we-serve-about-grid::-webkit-scrollbar {
        display: none;
    }
    .serve-about-item {
        flex: 0 0 auto;
        width: 110px;
        max-width: none;
    }
    .serve-about-icon-wrapper {
        width: 80px; 
        height: 80px;
        margin-bottom: 12px;
        padding: 14px;
        border-width: 2px;
    }
    .serve-about-title {
        font-size: 13px;
        line-height: 1.3;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }}-padding">
  <div class="who-we-serve-about-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="who-we-serve-about-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="who-we-serve-about-grid">
      {%- for block in section.blocks -%}
        <div class="serve-about-item" {{ block.shopify_attributes }}>
          <div class="serve-about-icon-wrapper">
            {%- if block.settings.icon_image != blank -%}
              {{
                block.settings.icon_image
                | image_url: width: 120
                | image_tag:
                  class: 'serve-about-icon',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#149B77" stroke-width="1.5" class="serve-about-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            {%- endif -%}
          </div>
          <p class="serve-about-title">{{ block.settings.title | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
