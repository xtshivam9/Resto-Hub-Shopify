{% schema %}
{
  "name": "About Banner",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a9d6e"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ABOUT US"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We provide a wide range of hospitality and food packaging essentials"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About Banner"
    }
  ]
}
{% endschema %}

{%- liquid
  if collection != blank
    assign banner_title = collection.title
    assign banner_subtitle = collection.description | strip_html | strip
  else
    assign banner_title = section.settings.title
    assign banner_subtitle = section.settings.subtitle
  endif
-%}

<div
  class="about-banner"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width about-banner__content">
    <h1 class="about-banner__title" style="color: {{ section.settings.text_color }};">{{ banner_title }}</h1>
    {%- if banner_subtitle != blank -%}
      <p class="about-banner__subtitle">{{ banner_subtitle }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap');

  .about-banner {
    text-align: center;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Rethink Sans', sans-serif;
  }
  .about-banner__content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .about-banner__title {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.2;
    text-transform: uppercase;
    font-family: 'Rethink Sans', sans-serif;
  }
  .about-banner__subtitle {
    font-size: 18px;
    margin: 0;
    line-height: 1.5;
    font-family: 'Rethink Sans', sans-serif;
  }
  @media screen and (max-width: 749px) {
    .about-banner {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }
    .about-banner__content {
        max-width: 100%;
        padding: 0 0.5rem;
    }
    .about-banner__title {
        font-size: 32px;
    }
    .about-banner__subtitle {
        font-size: min(16px, calc((100vw - 1rem) / 38));
        white-space: nowrap;
    }
  }
</style>
