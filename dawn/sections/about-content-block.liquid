{% comment %}theme-check-disable UnknownObject{% endcomment %}
{% # theme-check-disable UnknownObject %}
{% schema %}
{
  "name": "About Content Block",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your content here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Upload)"
    },
    {
      "type": "text",
      "id": "image_filename",
      "label": "Image Filename (Asset)",
      "info": "Enter filename like 'my-image.svg' to use from assets."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "right", "label": "Image Right / Text Left" },
        { "value": "left", "label": "Image Left / Text Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile Order",
      "options": [
        { "value": "text_first", "label": "Text First, Image Below" },
        { "value": "image_first", "label": "Image First, Text Below" }
      ],
      "default": "text_first"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About Content Block"
    }
  ]
}
{% endschema %}

<link href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{% style %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .about-block-{{ section.id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    font-family: 'Rethink Sans', sans-serif;
    display: flex;
    align-items: center;
    gap: 40px;
    {% if section.settings.image_position == 'right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .about-block__content-{{ section.id }} {
    flex: 1;
    text-align: left;
    {% if section.settings.image_position == 'right' %}
      padding-right: 20px;
    {% else %}
      padding-left: 20px;
    {% endif %}
  }

  .about-block__heading-{{ section.id }} {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 42px;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 24px;
    color: #000000;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-block__text-{{ section.id }} {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 18px;
    line-height: 1.6;
    color: #121212;
    font-weight: 400;
  }

  .about-block__text-{{ section.id }} p {
    margin-top: 0;
    margin-bottom: 24px;
    font-family: 'Rethink Sans', sans-serif !important;
  }

  .about-block__text-{{ section.id }} p:last-child {
    margin-bottom: 0;
  }

  .about-block__text-{{ section.id }} p:has(+ ul) {
    margin-bottom: 0;
  }

  .about-block__text-{{ section.id }} ul {
    margin-top: 0;
    margin-bottom: 24px;
    padding-left: 20px;
    font-family: 'Rethink Sans', sans-serif !important;
  }

  .about-block__text-{{ section.id }} li {
    margin-bottom: 8px;
    font-family: 'Rethink Sans', sans-serif !important;
  }

  .about-block__image-container-{{ section.id }} {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-block__image-{{ section.id }} {
    width: 100%;
    max-width: 85%;
    margin: 0 auto;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
    object-fit: contain;
    display: block;
  }

  .about-block__image-{{ section.id }}[src*=".svg"] {
    width: 100%;
    max-width: 85%;
  }

  .about-block__placeholder-{{ section.id }} {
    width: 100%;
    max-width: 85%;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
    border-radius: {{ section.settings.image_border_radius }}px;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed #ccc;
  }

  .about-block__placeholder-{{ section.id }} svg {
    width: 64px;
    height: 64px;
    opacity: 0.3;
  }

  @media screen and (max-width: 990px) {
    .about-block__heading-{{ section.id }} {
      font-size: 32px;
    }
    .about-block-{{ section.id }} {
      gap: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .about-block-{{ section.id }} {
      flex-direction: column;
      flex-wrap: wrap;
      padding: 0 1.5rem;
      gap: 0;
    }

    .about-block__image-container-{{ section.id }} {
      width: 100%;
      order: 1;
      margin-bottom: 20px;
    }

    .about-block__heading-mobile-{{ section.id }} {
      display: block;
    }

    .about-block__heading-desktop-{{ section.id }} {
      display: none;
    }

    .about-block__heading-mobile-{{ section.id }} {
      font-size: 22px;
      margin-top: 2px;
      margin-bottom: 12px;
      padding: 0 1rem;
      margin-left: 0;
      text-align: left;
      align-self: flex-start;
      order: 2;
      width: 100%;
    }

    .about-block__content-{{ section.id }} {
      width: 100%;
      padding-left: 1rem;
      padding-right: 1rem;
      text-align: left;
      order: 3;
    }

    .about-block__text-{{ section.id }} {
      font-size: 15px;
    }

    .about-block__image-{{ section.id }} {
      max-width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .about-block__heading-mobile-{{ section.id }} {
      display: none;
    }

    .about-block__heading-desktop-{{ section.id }} {
      display: block;
    }
  }
{% endstyle %}

{%- comment -%}
  Determine element order based on image_position:
  - image_position "left"  => image first in HTML, text second
  - image_position "right" => text first in HTML, image second
{%- endcomment -%}

<div class="section-{{ section.id }}-padding">
  <div class="about-block-{{ section.id }}">
    {% if section.settings.image_position == 'left' %}
      {%- comment -%} Image Left, Text Right {%- endcomment -%}
      <div class="about-block__image-container-{{ section.id }}">
        {%- if section.settings.image_filename != blank -%}
          <img
            src="{{ section.settings.image_filename | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="about-block__image-{{ section.id }}"
            loading="lazy"
            width="600"
            height="auto"
          >
        {%- elsif section.settings.image != blank -%}
          {%- assign image_class = 'about-block__image-' | append: section.id -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: class: image_class,
              loading: 'lazy',
              width: section.settings.image.width,
              height: section.settings.image.height
          }}
        {%- else -%}
          <div class="about-block__placeholder-{{ section.id }}">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Mobile-only heading (shows between image and text on mobile) {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-block__heading-{{ section.id }} about-block__heading-mobile-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="about-block__content-{{ section.id }}">
        {%- comment -%} Desktop-only heading (shows inside content column on desktop) {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-block__heading-{{ section.id }} about-block__heading-desktop-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="about-block__text-{{ section.id }}">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </div>
    {% else %}
      {%- comment -%} Text Left, Image Right {%- endcomment -%}
      <div class="about-block__image-container-{{ section.id }}">
        {%- if section.settings.image_filename != blank -%}
          <img
            src="{{ section.settings.image_filename | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="about-block__image-{{ section.id }}"
            loading="lazy"
            width="600"
            height="auto"
          >
        {%- elsif section.settings.image != blank -%}
          {%- assign image_class = 'about-block__image-' | append: section.id -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: class: image_class,
              loading: 'lazy',
              width: section.settings.image.width,
              height: section.settings.image.height
          }}
        {%- else -%}
          <div class="about-block__placeholder-{{ section.id }}">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Mobile-only heading (shows between image and text on mobile) {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-block__heading-{{ section.id }} about-block__heading-mobile-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="about-block__content-{{ section.id }}">
        {%- comment -%} Desktop-only heading (shows inside content column on desktop) {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-block__heading-{{ section.id }} about-block__heading-desktop-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="about-block__text-{{ section.id }}">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </div>
    {% endif %}
  </div>
</div>
