{% comment %} theme-check-disable {% endcomment %}
<style>
  .cvc-section {
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }
  .cvc-heading {
    text-align: center;
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 40px;
    color: #000;
  }
  .cvc-container {
    display: flex;
    align-items: center;
    position: relative;
  }
  .cvc-carousel {
    display: flex;
    overflow-x: auto;
    scroll-behavior: smooth;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding: 10px 0;
    flex: 1;
    scroll-snap-type: x mandatory;
  }
  .cvc-carousel::-webkit-scrollbar {
    display: none;
  }
  .cvc-card {
    flex: 0 0 calc(25% - 15px);
    margin-right: 20px;
    scroll-snap-align: start;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    aspect-ratio: 9/16;
  }
  .cvc-card:last-child {
    margin-right: 0;
  }
  @media (max-width: 1024px) {
    .cvc-card {
      flex: 0 0 calc(33.333% - 14px);
    }
  }
  @media (max-width: 768px) {
    .cvc-card {
      flex: 0 0 calc(50% - 10px);
    }
    .cvc-heading {
      font-size: 24px;
    }
  }
  .cvc-card:hover {
    transform: translateY(-5px);
  }
  .cvc-thumbnail {
    width: 100%;
    height: 100%;
    position: relative;
  }
  .cvc-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cvc-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .cvc-play-button svg {
    width: 35px;
    height: 35px;
    fill: #fff;
    margin-left: 4px; /* to visibly center the triangle */
  }
  .cvc-nav {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    color: #128b62; /* Green navigation arrows */
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .cvc-nav svg {
    width: 32px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cvc-nav:hover {
    color: #0b6143;
  }
  .cvc-nav.prev {
    left: 0px;
  }
  .cvc-nav.next {
    right: 0px;
  }
  .cvc-carousel-wrapper {
    padding: 0 50px; /* Make room for navigation arrows */
    width: 100%;
  }

  /* Modal Styles */
  .cvc-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cvc-modal.active {
    display: flex;
    opacity: 1;
  }
  .cvc-modal-content {
    position: relative;
    width: 90%;
    max-width: 450px;
    background: #000;
    border-radius: 16px;
    overflow: hidden;
  }
  .cvc-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    line-height: 1;
  }
  .cvc-video-player {
    width: 100%;
    display: block;
    max-height: 80vh;
  }
</style>

<div class="cvc-section" id="VideoCarousel-{{ section.id }}">
  <h2 class="cvc-heading">{{ section.settings.heading }}</h2>
  <div class="cvc-container">
    <button class="cvc-nav prev" id="cvc-prev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="cvc-carousel-wrapper">
      <div class="cvc-carousel" id="cvc-carousel-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign video_url = '' %}
          {% if block.settings.video != blank %}
            {% for source in block.settings.video.sources %}
              {% if source.format == 'mp4' or source.format == 'mov' %}
                {% assign video_url = source.url %}
              {% endif %}
            {% endfor %}
            {% if video_url == '' and block.settings.video.sources.size > 0 %}
              {% assign video_url = block.settings.video.sources[0].url %}
            {% endif %}
          {% endif %}

          {% if video_url == '' and block.settings.external_video_url != blank %}
            {% assign video_url = block.settings.external_video_url %}
          {% endif %}

          <div class="cvc-card" data-video="{{ video_url }}" {{ block.shopify_attributes }}>
            <div class="cvc-thumbnail">
              {% if block.settings.thumbnail != blank %}
                {{
                  block.settings.thumbnail
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: block.settings.title
                }}
              {% elsif block.settings.video != blank %}
                {{
                  block.settings.video.preview_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: block.settings.title
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              <div class="cvc-play-button">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <button class="cvc-nav next" id="cvc-next-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>

<div class="cvc-modal" id="cvc-modal-{{ section.id }}">
  <div class="cvc-modal-content">
    <button class="cvc-modal-close" id="cvc-close-{{ section.id }}">&times;</button>
    <video class="cvc-video-player" id="cvc-player-{{ section.id }}" controls playsinline>
      <source src="" type="video/mp4">
      Your browser does not support HTML5 video.
    </video>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const carouselId = '{{ section.id }}';
    const carousel = document.getElementById('cvc-carousel-' + carouselId);
    const prevBtn = document.getElementById('cvc-prev-' + carouselId);
    const nextBtn = document.getElementById('cvc-next-' + carouselId);

    if (carousel && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const scrollAmount = carousel.clientWidth / 2;
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const scrollAmount = carousel.clientWidth / 2;
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }

    const cards = document.querySelectorAll('#VideoCarousel-' + carouselId + ' .cvc-card');
    const modal = document.getElementById('cvc-modal-' + carouselId);
    const closeBtn = document.getElementById('cvc-close-' + carouselId);
    const player = document.getElementById('cvc-player-' + carouselId);

    if (!cards.length || !modal || !player) return;

    cards.forEach((card) => {
      card.addEventListener('click', function (e) {
        e.preventDefault();
        const videoUrl = this.getAttribute('data-video');
        if (videoUrl) {
          player.src = videoUrl;
          modal.classList.add('active');
          player.load();
          player.play().catch((err) => console.log('Auto-play prevented', err));
        }
      });
    });

    const closeModal = () => {
      modal.classList.remove('active');
      player.pause();
      player.src = '';
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Video Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By Others"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video"
        },
        {
          "type": "url",
          "id": "external_video_url",
          "label": "External Video URL (MP4)",
          "info": "Use this if you have a direct link to an MP4 video."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Custom Thumbnail Image",
          "info": "Leave blank to use the video's default preview image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Video Carousel",
      "blocks": [
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" }
      ]
    }
  ]
}
{% endschema %}
