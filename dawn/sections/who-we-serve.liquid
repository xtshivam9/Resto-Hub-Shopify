{% schema %}
{
  "name": "Who We Serve",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who We Serve"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
       "type": "color",
       "id": "bg_color",
       "label": "Background Color",
       "default": "#F9FDFB"
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Service Name"
        },
        {
           "type": "html",
           "id": "svg_icon",
           "label": "SVG Icon (Paste SVG code or filename)",
           "info": "Enter the filename of the uploaded asset (e.g., 'we-serve1.svg') or paste SVG code."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who We Serve",
      "blocks": [
        {
          "type": "service_item",
          "settings": {
            "title": "Restaurants & QSRs",
            "svg_icon": "we-serve1.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Cafés & Coffee Chains",
            "svg_icon": "we-serve2.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Catering Companies",
            "svg_icon": "we-serve3.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Food Trucks & Cloud Kitchens",
            "svg_icon": "we-serve4.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Event Planners & Venues",
            "svg_icon": "we-serve5.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Franchise & Multi-Location Brands",
            "svg_icon": "we-serve6.svg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
{% comment %} Schema updated {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .who-we-serve-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
    font-family: 'Rethink Sans', sans-serif;
  }

  .who-we-serve-heading {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 40px;
    font-weight: 600;
    margin-bottom: 4rem;
    color: #000; 
  }

  .who-we-serve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    justify-items: center;
  }

  .serve-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 200px; /* Increased to allow single line for top items, while wrapping longer ones */
  }

  .serve-icon-wrapper {
    width: 110px; /* Reduced from 130px */
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    border: 4px solid #149B77; /* Thicker border as requested */
    border-radius: 50%;
    padding: 24px; /* Reduced from 28px */
    transition: all 0.3s ease;
  }
  
  .serve-item:hover .serve-icon-wrapper {
    transform: scale(1.05);
    background-color: rgba(20, 155, 119, 0.05);
  }

  .serve-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .serve-title {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: #000;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .who-we-serve-heading {
        font-size: 32px;
        margin-bottom: 3rem;
    }
    .who-we-serve-grid {
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .who-we-serve-wrapper {
        padding: 0 1.5rem;
    }
    .who-we-serve-heading {
        font-size: 28px;
        margin-bottom: 2rem;
    }
    .who-we-serve-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 columns on mobile */
      gap: 20px;
      column-gap: 15px; 
    }
    .serve-icon-wrapper {
        width: 90px; /* Reduced from 100px */
        height: 90px;
        margin-bottom: 12px;
        padding: 18px; /* Reduced from 20px */
        border-width: 3px;
    }
    .serve-title {
        font-size: 14px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }}-padding">
  <div class="who-we-serve-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="who-we-serve-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="who-we-serve-grid">
      {%- for block in section.blocks -%}
        <div class="serve-item" {{ block.shopify_attributes }}>
          <div class="serve-icon-wrapper">
            {%- if block.settings.svg_icon contains '.svg' -%}
              <img
                src="{{ block.settings.svg_icon | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="serve-icon"
                loading="lazy"
                width="120"
                height="120"
              >
            {%- else -%}
              {{ block.settings.svg_icon }}
            {%- endif -%}
          </div>
          <p class="serve-title">{{ block.settings.title | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
