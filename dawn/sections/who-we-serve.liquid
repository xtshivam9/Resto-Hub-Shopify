{% schema %}
{
  "name": "Who We Serve",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who We Serve"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9FDFB"
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Service Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Durable containers built for high-heat and long-distance transport."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "SVG Image (fallback)",
          "info": "Used only if no Card Image is selected. Enter filename (e.g., 'serve1.svg') or paste SVG code."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "VIEW PRODUCTS →"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who We Serve",
      "blocks": [
        {
          "type": "service_item",
          "settings": {
            "title": "Restaurants & QSRs",
            "description": "Durable containers built for high-heat and long-distance transport.",
            "svg_icon": "serve1.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Cafés & Coffee Chains",
            "svg_icon": "serve2.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Food Trucks & Cloud Kitchens",
            "svg_icon": "serve3.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Catering Companies",
            "svg_icon": "serve4.svg"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "title": "Event Planners",
            "svg_icon": "serve5.svg"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden; /* Ensure no horizontal scroll on the section itself */
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .who-we-serve-wrapper {
    max-width: 1400px; /* Wider to allow more visible cards */
    margin: 0 auto;
    padding-left: 2rem; /* Left padding for alignment */
    /* Right padding handled by card container to allow scroll bleed */
    font-family: 'Rethink Sans', sans-serif;
  }

  .who-we-serve-heading {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 40px;
    font-weight: 600;
    margin-bottom: 2rem;
    color: #000;
    text-align: left;
  }

  .who-we-serve-scroll-container {
    display: flex;
    overflow-x: auto;
    gap: 20px;
    padding-bottom: 30px; /* Space for scrollbar */
    padding-right: 2rem; /* Right padding */
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .who-we-serve-scroll-container:active {
    cursor: grabbing;
  }

  /* Custom Scrollbar Styling */
  .who-we-serve-scroll-container::-webkit-scrollbar {
    height: 6px; /* Slim scrollbar height */
    width: 6px;
  }

  .who-we-serve-scroll-container::-webkit-scrollbar-track {
    background: #E0E0E0;
    border-radius: 4px;
    margin: 0 2rem 0 0; /* Add margin to align with content */
  }

  .who-we-serve-scroll-container::-webkit-scrollbar-thumb {
    background-color: #149B77; /* Theme Green */
    border-radius: 4px;
  }

  .serve-card {
    flex: 0 0 auto;
    width: 300px; /* Fixed width for standard cards */
    height: 400px;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background-color: #f0f0f0; /* Fallback */
  }

  .serve-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Handle SVG content specifically */
  .serve-card-image svg {
    width: 100%;
    height: 100%;
  }

  /* ---- Overlay: default = title only ---- */
  .serve-card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.45) 60%, rgba(0,0,0,0) 100%);
    padding: 20px;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 35%; /* Smaller overlay by default */
    transition: height 0.4s ease;
  }

  /* ---- On card hover, expand overlay ---- */
  .serve-card:hover .serve-card-overlay {
    height: 70%;
  }

  .serve-card-title {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: #fff;
    text-align: left;
    transition: margin 0.3s ease;
  }

  .serve-card:hover .serve-card-title {
    margin-bottom: 10px;
  }

  /* ---- Hidden by default ---- */
  .serve-card-description {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 16px 0;
    color: #ddd;
    line-height: 1.4;
    text-align: left;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.35s ease 0.1s, max-height 0.4s ease;
  }

  .serve-card:hover .serve-card-description {
    opacity: 1;
    max-height: 200px;
  }

  .serve-card-link {
    font-family: 'Rethink Sans', sans-serif !important;
    font-size: 13px;
    font-weight: 500;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background: none;
    border: none;
    padding: 0;
    align-self: flex-start;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.35s ease 0.15s, max-height 0.4s ease;
  }

  .serve-card:hover .serve-card-link {
    opacity: 1;
    max-height: 50px;
  }

  .serve-card-link:hover {
    color: #149B77;
  }

  @media screen and (max-width: 749px) {
    .who-we-serve-wrapper {
        padding-left: 1.5rem;
    }
    .who-we-serve-heading {
        font-size: 28px;
    }
    .serve-card {
        width: 260px;
        height: 350px;
    }
    .serve-card-title {
        font-size: 18px;
    }
  }

  @media screen and (max-width: 480px) {
    .serve-card {
        width: 220px;
        height: 300px;
    }
    .serve-card-title {
        font-size: 16px;
    }
    .serve-card-description {
        font-size: 12px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }}-padding">
  <div class="who-we-serve-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="who-we-serve-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="who-we-serve-scroll-container">
      {%- for block in section.blocks -%}
        <div class="serve-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.title | escape }}"
              class="serve-card-image"
              loading="lazy"
              width="300"
              height="400"
            >
          {%- elsif block.settings.svg_icon != blank -%}
            {%- if block.settings.svg_icon contains '.svg' -%}
              <img
                src="{{ block.settings.svg_icon | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="serve-card-image"
                loading="lazy"
                width="300"
                height="400"
              >
            {%- else -%}
              <div class="serve-card-image">
                {{ block.settings.svg_icon }}
              </div>
            {%- endif -%}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'serve-card-image' }}
          {%- endif -%}

          <div class="serve-card-overlay">
            <h3 class="serve-card-title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="serve-card-description">{{ block.settings.description | escape }}</p>
            {%- endif -%}

            {%- assign btn_label = block.settings.link_label | default: 'VIEW PRODUCTS →' -%}
            {%- assign btn_url = block.settings.link_url | default: '#' -%}
            <a href="{{ btn_url }}" class="serve-card-link">
              {{ btn_label | escape }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
