{% schema %}
{
  "name": "Who We Are",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who We Are"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>RestoSupplyHub is a Canada-based hospitality packaging supplier dedicated to helping restaurants, hotels, cafés, caterers, and food service businesses operate smoothly and efficiently.</p><p>Based in the Greater Toronto Area, we serve businesses nationwide with dependable access to high-quality packaging and essential service products. Our goal is simple — to make sourcing smarter, faster, and more reliable for hospitality professionals across Canada.</p><p>We believe packaging is more than just a product — it’s part of your brand experience.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Who We Are"
    }
  ]
}
{% endschema %}

<div class="who-we-are-section" style="background-color: {{ section.settings.background_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="who-we-are__grid">
      <div class="who-we-are__content">
        <h2 class="who-we-are__heading">{{ section.settings.heading }}</h2>
        <div class="who-we-are__text rte">
          {{ section.settings.content }}
        </div>
      </div>
      <div class="who-we-are__image-wrapper">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 800 | image_tag: class: 'who-we-are__image', loading: 'lazy' }}
        {% else %}
          <img src="{{ 'who-we-are.svg' | asset_url }}" class="who-we-are__image" alt="Who We Are" loading="lazy" width="800" height="auto">
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&display=swap');

  .who-we-are-section {
    font-family: 'Rethink Sans', sans-serif;
  }
  .who-we-are-section .page-width {
    max-width: 1400px;
    padding-left: 3rem;
    padding-right: 3rem;
  }
  @media screen and (min-width: 750px) {
    .who-we-are-section .page-width {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }
  .who-we-are__grid {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-direction: row;
  }
  .who-we-are__content {
    flex: 1;
    text-align: left;
  }
  .who-we-are__image-wrapper {
    flex: 1;
  }
  .who-we-are__image {
    width: 100%;
    max-width: 85%; /* Reduced size */
    margin: 0 auto; /* Centered */
    height: auto;
    border-radius: 30px;
    display: block;
    object-fit: cover;
  }
  .who-we-are__image.placeholder-svg {
    background-color: #f0f0f0;
    min-height: 400px; /* Ensure visibility if SVG collapses */
  }
  .who-we-are__heading {
    font-size: 40px;
    font-weight: 700;
    margin-bottom: 30px;
    color: #000;
    font-family: 'Rethink Sans', sans-serif;
  }
  .who-we-are__text {
    font-size: 18px;
    line-height: 1.6;
    color: #333;
    font-family: 'Rethink Sans', sans-serif;
  }
  .who-we-are__text p {
    margin-bottom: 20px;
  }
  .who-we-are__text p:last-child {
      margin-bottom: 0;
  }

  @media screen and (max-width: 990px) {
    .who-we-are__grid {
        gap: 40px;
    }
    .who-we-are__heading {
        font-size: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .who-we-are-section {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }
    .who-we-are-section .page-width {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
    .who-we-are__grid {
      flex-direction: column;
      gap: 30px;
    }
    .who-we-are__heading {
        margin-bottom: 20px;
        font-size: 28px;
    }
    .who-we-are__text {
        font-size: 15px;
    }
    .who-we-are__image {
        border-radius: 20px;
        max-width: 100%;
    }
  }
</style>
