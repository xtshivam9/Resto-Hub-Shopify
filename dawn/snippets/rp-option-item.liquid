{% doc %}
  Renders a dropdown option item for the right-packaging section.

  @param {product} rp_product - The product to render as an option

  @example
  {% render 'rp-option-item', rp_product: product %}
{% enddoc %}

<li
  class="rp-option-item"
  data-product-handle="{{ rp_product.handle }}"
  data-collection-handle="{{ collection_handle }}"
  onclick="selectOption(this)"
>
  <span class="rp-option-checkbox">
    <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 5L4.5 8.5L11 1.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class="rp-option-label">{{ rp_product.title }}</span>
</li>
