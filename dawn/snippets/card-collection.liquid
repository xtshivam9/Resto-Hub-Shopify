{% comment %}
  Renders a collection card

  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - columns: {Number}
  - extend_height: {Boolean} Card height extends to available container space. Default: false (optional)
  - wrapper_class: {String} Wrapper class for card (optional)
  - placeholder_image: {String} Placeholder image when collection is empty (optional)

  Usage:
  {% render 'card-collection' %}
{% endcomment %}

{%- liquid
  assign ratio = 1
  if card_collection.featured_image and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif card_collection.featured_image and media_aspect_ratio == 'adapt'
    assign ratio = card_collection.featured_image.aspect_ratio
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
-%}

<div class="custom-collection-card animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% endif %}">
  <a href="{{ card_collection.url | default: '#' }}" class="custom-collection-card__link">
    <div class="custom-collection-card__inner" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
      {%- if card_collection.featured_image -%}
        <div class="custom-collection-card__media">
          <img
            srcset="
              {%- if card_collection.featured_image.width >= 165 -%}{{ card_collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if card_collection.featured_image.width >= 330 -%}{{ card_collection.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
              {%- if card_collection.featured_image.width >= 535 -%}{{ card_collection.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
              {%- if card_collection.featured_image.width >= 750 -%}{{ card_collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if card_collection.featured_image.width >= 1000 -%}{{ card_collection.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
              {{ card_collection.featured_image | image_url }} {{ card_collection.featured_image.width }}w
            "
            src="{{ card_collection.featured_image | image_url: width: 1500 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px, (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %}, calc(100vw - 3rem)"
            alt="{{ card_collection.featured_image.alt | escape }}"
            height="{{ card_collection.featured_image.height }}"
            width="{{ card_collection.featured_image.width }}"
            loading="lazy"
            class="motion-reduce custom-collection-card__image"
          >
        </div>
      {%- elsif card_collection == blank -%}
        <div class="custom-collection-card__media custom-collection-card__media--placeholder">
          {{ placeholder_image | default: 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- else -%}
        <div class="custom-collection-card__media custom-collection-card__media--empty"></div>
      {%- endif -%}

      <div class="custom-collection-card__content">
        <h3 class="custom-collection-card__title">
          {%- if card_collection.title != blank -%}
            {{- card_collection.title | escape -}}
          {%- else -%}
            {{ 'onboarding.collection_title' | t }}
          {%- endif -%}
        </h3>

        {%- if card_collection.description != blank -%}
          <p class="custom-collection-card__description">
            {{- card_collection.description | strip_html | truncatewords: 15 -}}
          </p>
        {%- endif -%}

        <div class="custom-collection-card__footer">
          <span class="custom-collection-card__action">
            Shop Collection
            <svg viewBox="0 0 14 10" fill="none" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
            </svg>
          </span>
        </div>
      </div>
    </div>
  </a>
</div>

<style>
  .custom-collection-card {
    display: block;
    height: 100%;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .custom-collection-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .custom-collection-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .custom-collection-card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .custom-collection-card__media {
    position: relative;
    width: 100%;
    padding-bottom: var(--ratio-percent, 100%);
    overflow: hidden;
    background-color: #f8f8f8;
  }

  .custom-collection-card__media--empty {
    padding-bottom: 60%; /* Taller for empty state to look balanced */
    background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
  }

  .custom-collection-card__image,
  .custom-collection-card__media > svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .custom-collection-card:hover .custom-collection-card__image {
    transform: scale(1.05);
  }

  .custom-collection-card__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .custom-collection-card__title {
    font-family: 'Rethink Sans', sans-serif; /* Align with theme */
    font-size: 22px;
    font-weight: 700;
    color: #121212;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .custom-collection-card__description {
    font-size: 15px;
    color: #555555;
    margin: 0 0 24px 0;
    line-height: 1.5;
    flex-grow: 1; /* Pushes footer to bottom */
  }

  .custom-collection-card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
  }

  .custom-collection-card__action {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 15px;
    color: #149b77; /* Using theme green */
    transition: color 0.3s ease;
  }

  .custom-collection-card__action svg {
    width: 12px;
    height: 12px;
    margin-left: 8px;
    transition: transform 0.3s ease;
  }

  .custom-collection-card:hover .custom-collection-card__action {
    color: #0d7a5d;
  }

  .custom-collection-card:hover .custom-collection-card__action svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .custom-collection-card {
      border-radius: 12px;
    }
    .custom-collection-card__media {
      padding-bottom: 80%; /* Reduce image height to be less than a square */
    }
    .custom-collection-card__content {
      padding: 12px;
    }
    .custom-collection-card__title {
      font-size: 16px;
      margin: 0 0 4px 0;
    }
    .custom-collection-card__description {
      font-size: 13px;
      line-height: 1.3;
      margin: 0 0 12px 0;
    }
    .custom-collection-card__action {
      font-size: 12px;
    }
    .custom-collection-card__action svg {
      width: 10px;
      height: 10px;
    }
  }
</style>
